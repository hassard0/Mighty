// Note: spec §16.1 places `sandbox` at top level. Slice 2 keeps it as
// an expression-position construct (wrapped in fn tool_run); the inner
// `run job(input)?` body now uses the real RUN_EXPR form. Top-level
// sandbox items remain a slice-3 item.
fn tool_run(input: Bytes) -> Unit!RunErr {
  sandbox ToolRun with {
    fs.read = ["/models", "/tmp/input.json"]
    fs.write = ["/tmp/out"]
    net = ["api.example.com:443"]
    cpu = 150ms
    wall = 2s
    memory = 128MiB
    mailbox = 1k
  } {
    run job(input)?
  }
}
