// Demo 11 — minimal FFI scaffold for a winit-style app.
//
// This is the v0.36 Track T2 scaffold the native-IDE track
// (C:\Users\ihass\mighty-ide) uses to bootstrap a real wgpu/winit
// integration. The C shim under `vendor/winit_shim.c` is deliberately
// a no-op so the smoke test stays hermetic; a real binding would
// replace the shim with libwinit + libwgpu and add the matching
// `[[extern_lib]]` entries to mighty.toml.
extern c {
  fn winit_shim_init() -> I32
  fn winit_shim_open_window(w: I32, h: I32, title_ptr: *U8, title_len: USize) -> I32
  fn winit_shim_run_event_loop_once() -> I32
  fn winit_shim_shutdown() -> I32
}

fn main() {
  let rc = winit_shim_init()
  log("ffi_winit_stub: init=...")
  let opened = winit_shim_open_window(640, 480, "mty-ide", 7)
  log("ffi_winit_stub: opened=...")
  let _ = winit_shim_run_event_loop_once()
  let _ = winit_shim_shutdown()
  log("ffi_winit_stub: clean shutdown")
}
