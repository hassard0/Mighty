}

fn lower_array_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("Array")
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_expr_node_kind(ck) == true {
      let _ = lower_expr(c)
