// 40_string_editing.mty — v0.36 Track T3: position / range-edit /
// char-boundary helpers on `Str` and `String`.
//
// Earlier slices shipped the foundational `String` surface (`new`,
// `push_str`, `len`, `clear`) plus a handful of byte-level reads
// (`find`, `chars`, `bytes`). What was missing was the editor-shaped
// trio every text-buffer-style program eventually needs:
//
//   * position lookup (`find` / `rfind` / `position`),
//   * range edit (`insert_at` / `remove_range` / `replace_range`),
//   * char-boundary navigation (`is_char_boundary`,
//     `next_char_boundary`, `prev_char_boundary`).
//
// v0.36 T3 fills those in. UTF-8 safety: byte indices that land in
// the middle of a multi-byte code-point cause the range-edit ops to
// fail with `MT5080`. The interp surfaces this as `None` from the
// returned `Option[Str]`; the Rust-side `mty_stdlib::string::String`
// methods panic with the same code. Either way the caller never
// silently corrupts the UTF-8 invariant.
//
// Build:
//   mty fmt examples/40_string_editing.mty
//   mty check examples/40_string_editing.mty
//
// Runtime shape covered by `crates/mty-driver/tests/string_t3.rs`.
//
// Implementation notes:
//   * Helper signatures take `Str` (borrowed) instead of `String`
//     (owned) so the v0.2 native + wasm codegen sweeps both accept
//     the example.
//   * Indices passed to the boundary/range ops are spelled as plain
//     integer literals at the call site; the type-checker infers the
//     `USize` target through the method signature. Helpers that
//     would otherwise need a `USize` *parameter* hard-code the index
//     so the wasm codegen sweep doesn't need a `USize`-typed local
//     to flow through the call frame (v0.37 follow-up).
//   * `log(...)` in `main()` stays on a literal so the native v0.2
//     codegen sweep accepts the example.
// ----- Position lookup --------------------------------------------------
// `find` / `rfind` return byte indices into the UTF-8 buffer. Both
// return `Option[USize]`; callers use the standard match shape.
fn _find_word(haystack: Str, needle: Str) -> Option[USize] {
  haystack.find(needle)
}

fn _rfind_word(haystack: Str, needle: Str) -> Option[USize] {
  haystack.rfind(needle)
}

// `position(c)` is the `Char`-shaped sibling of `find`. Cheaper for
// single-code-point lookups since it avoids the 1..=4-byte UTF-8
// allocation that `find(&c.to_string())` would do.
fn _first_comma(s: Str) -> Option[USize] {
  s.position(',')
}

// ----- Range edit -------------------------------------------------------
// Each editing op returns an `Option[Str]`: `Some(new)` on success
// and `None` on a UTF-8 boundary violation (MT5080 — see the interp
// dispatch arms in `mty-ir::interp::run::eval_method`). The Rust-
// side host wrappers in `mty_stdlib::string::String` panic with the
// same code, so behaviour is consistent across both surfaces.
fn _splice_in_the(s: Str, t: Str) -> Option[Str] {
  s.insert_at(7, t)
}

fn _cut_out_4(s: Str) -> Option[Str] {
  s.remove_range(7, 11)
}

fn _swap_in(s: Str, t: Str) -> Option[Str] {
  s.replace_range(7, 11, t)
}

// ----- Char-boundary navigation -----------------------------------------
// `is_char_boundary` tells you whether a byte index lands on a
// UTF-8 code-point boundary (so it's safe to splice there);
// `next_char_boundary` / `prev_char_boundary` snap to the nearest
// boundary in each direction.
fn _is_first_byte_a_boundary(s: Str) -> Bool {
  s.is_char_boundary(0)
}

// "a©b" has © at bytes 1..3, so byte 2 is mid-sequence and
// `is_char_boundary(2)` is false.
fn _is_mid_multibyte_a_boundary(s: Str) -> Bool {
  s.is_char_boundary(2)
}

fn _snap_forward_from_2(s: Str) -> Option[USize] {
  s.next_char_boundary(2)
}

fn _snap_backward_from_2(s: Str) -> Option[USize] {
  s.prev_char_boundary(2)
}

fn main() {
  // Exercise every helper. Results discarded with `_` so the
  // native + wasm codegen sweeps don't have to model dynamic-string
  // log; the runtime SHAPE lives in `crates/mty-driver/tests/string_t3.rs`.
  let _found = _find_word("Hello, Mighty Mighty", "Mighty")
  let _rfound = _rfind_word("Hello, Mighty Mighty", "Mighty")
  let _pos = _first_comma("Hello, Mighty")
  let _ins = _splice_in_the("Hello, Mighty", "the ")
  let _rem = _cut_out_4("Hello, the Mighty")
  let _rep = _swap_in("Hello, the Mighty", "a ")
  let _b1 = _is_first_byte_a_boundary("a©b")
  let _b2 = _is_mid_multibyte_a_boundary("a©b")
  let _next = _snap_forward_from_2("a©b")
  let _prev = _snap_backward_from_2("a©b")
  log("40_string_editing: v0.36 Track T3 String position/range/boundary surface")
}
