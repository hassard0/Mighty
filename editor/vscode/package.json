{
  "name": "stardust",
  "displayName": "Stardust",
  "description": "Stardust language support (syntax + LSP) for VS Code.",
  "version": "0.5.0",
  "publisher": "stardust-lang",
  "license": "Apache-2.0 OR MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassard0/stardust.git",
    "directory": "editor/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:stardust"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "stardust",
        "aliases": [
          "Stardust",
          "sdust"
        ],
        "extensions": [
          ".sd"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "stardust",
        "scopeName": "source.stardust",
        "path": "./syntaxes/stardust.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "stardust.restartServer",
        "title": "Stardust: Restart Language Server"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.rename",
        "key": "f2",
        "when": "editorTextFocus && editorLangId == stardust"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "stardust",
        "scopes": {
          "macro": ["entity.name.function.macro.stardust"],
          "property": ["variable.other.property.stardust"]
        }
      }
    ],
    "configuration": {
      "title": "Stardust",
      "properties": {
        "stardust.server.path": {
          "type": "string",
          "default": "sdust",
          "description": "Path to the `sdust` binary. The extension launches `<path> lsp` over stdio."
        },
        "stardust.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Stardust LSP."
        },
        "stardust.inlayHints.enable": {
          "type": "boolean",
          "default": false,
          "description": "Show inferred-type hints next to `let` bindings and fn parameters. Off by default — toggle on if you prefer them visible."
        },
        "stardust.semanticTokens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Use the LSP's semantic-token classifier to highlight identifiers (functions, types, parameters, etc.) more precisely than the TextMate grammar can."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.21.0"
  }
}
