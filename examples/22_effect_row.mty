// 22_effect_row.mty — RFC-008 effect-row surface syntax (v0.16 typeck).
//
// Build:
//   mty fmt examples/22_effect_row.mty
//   mty check examples/22_effect_row.mty
//
// As of v0.16 the parser support (v0.15) is wired through HIR and the
// type checker: the row variable `E` propagates from each closure
// parameter's inferred effect set into the call-site caller's effect
// set, exactly as RFC-008 specifies.
//
// Surface forms (RFC-008 §Syntax):
//
//   * `!{| E}`           — bare row variable, braced (parses unambiguously)
//   * `!{}`              — empty closed row (= today's "pure" fn)
//   * `!{fs, net}`       — concrete closed row (no tail)
//   * `!{fs | E}`        — concrete + row-variable tail
//   * `!{fs, net | E}`   — multiple concrete + row tail
//   * `effect a, b | E`  — legacy keyword form, NEW row-tail extension
//
// PARSER NOTE: the bare `!IDENT` form (no braces) AFTER a path-typed
// return is committed to the legacy anonymous-error-union sugar
// (`Result[T, IDENT]`) for back-compat with `!FetchErr`. The braced
// `!{| E}` form is unambiguous and disambiguates as an effect clause
// regardless of the preceding return type — see
// `mty-syntax::parser::types::peeks_as_effect_row_clause`.
//
// (`_` prefix on helper fns keeps them out of the WIT export world;
// the example focus is the SIGNATURE syntax, not exportability —
// `Str`-returning helpers would otherwise need a runtime-side
// string-building stub to satisfy the wasm-component sweep.)

// Braced bare row-var form: open row with no concrete effects.
fn _observe[E](f: fn() -> Unit) -> Unit !{| E} {
}

// Concrete + row-tail form: "at least `fs`, plus whatever the closure
// brings". This is the most common shape for higher-order I/O
// wrappers (e.g. a logged-fs-read wrapper).
fn _observed_read[E](path: Str, log: fn(Str) -> Unit) -> Str !{fs | E} {
  ""
}

// Plain closed-row form — equivalent to `effect fs` but in the v0.15
// `!{}` shape.
fn _read_one(path: Str) -> Str !{fs} {
  ""
}

// Legacy `effect ...` form keeps working unchanged.
fn _read_two(path: Str) -> Str effect fs {
  ""
}

// NEW v0.15: the keyword form gains the same `| E` tail extension.
fn _read_three[E](path: Str, k: fn(Str) -> Unit) -> Str effect fs | E {
  ""
}

fn main() {
  log("22_effect_row: RFC-008 surface syntax and v0.16 typeck wiring")
}
