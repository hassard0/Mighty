##module option
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Option.map
##sig fn Option.map[T, U](self, f: fn(T) -> U) -> Option[U]
##desc Transform the `Some` value with `f`; pass `None` through unchanged.
##see Option.and_then, Option.unwrap_or, Result.map_err
##example
let len = Some("hi").map(|s| s.len());
assert_eq(len, Some(2));
##end

##sym Option.and_then
##sig fn Option.and_then[T, U](self, f: fn(T) -> Option[U]) -> Option[U]
##desc Monadic bind. Threads the inner value through `f`; short-circuits on `None`.
##see Option.map, Option.unwrap_or, Result.and_then
##example
let n = parse_int(s).and_then(|x| if x > 0 { Some(x) } else { None });
##end

##sym Option.unwrap_or
##sig fn Option.unwrap_or[T](self, default: T) -> T
##desc Return the `Some` value or `default` on `None`. Never panics.
##see Option.map, Option.ok_or, Result.unwrap_or
##example
let n = parse_int(s).unwrap_or(0);
##end

##sym Option.ok_or
##sig fn Option.ok_or[T, E](self, err: E) -> Result[T, E]
##desc Promote an `Option` to a `Result`, using `err` as the failure value.
##see Option.map, Result.ok, Result.err
##example
let r: Result[I32, Str] = parse_int(s).ok_or("bad int");
##end

##sym Option.or_else
##sig fn Option.or_else[F: FnOnce() -> Option[T]](self, f: F) -> Option[T]
##desc Lazy fallback: return `self` if `Some`, else invoke `f()` for the alternative. Prefer this over `or` when the alternative is expensive.
##see Option.or, Option.unwrap_or_else, Result.or_else
##example
let v = cache.get(k).copied().or_else(|| db.lookup(k));
##end

##sym Option.replace
##sig fn Option.replace(&mut self, value: T) -> Option[T]
##desc Replace `self` with `Some(value)` and return the previous content. Combine with `take` for swap-style updates.
##see Option.take, Option.unwrap
##example
let old = self.handler.replace(new_handler);
##end

##sym Option.unwrap
##sig fn Option.unwrap(self) -> T
##desc Panic if `None`, return the wrapped value if `Some`. Use ONLY when the absence of value is structurally impossible (post-condition of an earlier check). Prefer `unwrap_or` / `?` for runtime input.
##see Option.unwrap_or, Option.expect, Option.is_some
##example
let v = guaranteed_some.unwrap();
##end

##sym Option.expect
##sig fn Option.expect(self, msg: &Str) -> T
##desc Like `unwrap` but panics with a custom message. The message should describe the INVARIANT, not the failure ("channel must be open here" — not "channel was closed").
##see Option.unwrap, Option.unwrap_or, Result.expect
##example
let v = invariant_some.expect("checked above at line 42");
##end

