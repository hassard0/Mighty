##module vec
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Vec.new
##sig fn Vec.new[T]() -> Vec[T]
##desc Allocates an empty growable vector.
##see Vec.with_capacity, Vec.push, Vec.iter
##example
let mut v: Vec[I32] = Vec.new();
v.push(1);
##end

##sym Vec.with_capacity
##sig fn Vec.with_capacity[T](cap: USize) -> Vec[T]
##desc Allocates a vector pre-sized for `cap` elements. Avoids re-allocs on the hot path.
##see Vec.new, Vec.push
##example
let v: Vec[I32] = Vec.with_capacity(1024);
##end

##sym Vec.push
##sig fn Vec.push[T](&mut self, x: T) -> Unit
##desc Appends `x` to the back of the vector.
##see Vec.new, Vec.pop, Vec.iter
##example
v.push(42);
##end

##sym Vec.iter
##sig fn Vec.iter[T](&self) -> Iterator[T]
##desc Borrowed iterator over the vector's elements.
##see Vec.push, Vec.collect
##example
for x in v.iter() { log(format!("{}", x)); }
##end

##sym Vec.pop
##sig fn Vec.pop[T](&mut self) -> Option[T]
##desc Remove and return the last element, or `None` if the vector is empty.
##see Vec.push, Vec.len, Vec.is_empty
##example
let mut v = Vec.new();
v.push(42);
let x = v.pop();
assert_eq(x, Some(42));
##end

##sym Vec.len
##sig fn Vec.len[T](&self) -> USize
##desc Number of elements currently in the vector.
##see Vec.is_empty, Vec.push, Vec.capacity
##example
let n = v.len();
log(format!("len={}", n));
##end

##sym Vec.is_empty
##sig fn Vec.is_empty[T](&self) -> Bool
##desc True if the vector has zero elements. Equivalent to `len() == 0`.
##see Vec.len, Vec.clear
##example
if v.is_empty() { log("empty"); }
##end

##sym Vec.clear
##sig fn Vec.clear[T](&mut self)
##desc Drop every element. Preserves the underlying capacity so reuse is allocation-free.
##see Vec.pop, Vec.with_capacity, Vec.is_empty
##example
v.clear();
assert(v.is_empty());
##end

##sym Vec.get
##sig fn Vec.get[T](&self, idx: USize) -> Option[&T]
##desc Bounds-checked read. Returns `None` for out-of-range indices instead of panicking.
##see Vec.get_mut, Vec.iter, Vec.len
##example
match v.get(0) {
  Some(x) => log(format!("{}", x)),
  None => log("empty"),
}
##end

##sym Vec.capacity
##sig fn Vec.capacity[T](&self) -> USize
##desc Number of elements the vector can hold before re-allocating.
##see Vec.with_capacity, Vec.len
##example
let v: Vec[I32] = Vec.with_capacity(128);
assert(v.capacity() >= 128);
##end

##sym Vec.iter_mut
##sig fn Vec.iter_mut[T](&mut self) -> Iterator[&mut T]
##desc Iterator yielding mutable references. Use to update every element in place.
##see Vec.iter, Vec.get_mut
##example
for x in v.iter_mut() { *x = *x + 1; }
##end

##sym Vec.append
##sig fn Vec.append[T](&mut self, other: &mut Vec[T])
##desc Move every element from `other` to the back of `self`. `other` is left empty.
##see Vec.push, Vec.iter
##example
let mut a = Vec.new();
a.push(1);
let mut b = Vec.new();
b.push(2);
a.append(&mut b);
assert(b.is_empty());
##end

##sym Vec.from_elem
##sig fn Vec.from_elem[T](value: T, n: USize) -> Vec[T]
##desc Build a vector by cloning `value` `n` times. Useful for fixed-size board / buffer init.
##see Vec.with_capacity, Vec.new, Vec.push
##example
let board = Vec.from_elem(0_u32, 200);
assert_eq(board.len(), 200);
##end

##sym Vec.set
##sig fn Vec.set[T](&mut self, idx: USize, value: T)
##desc In-place update at `idx`. Bounds-checked: out-of-range index traps. With v0.39's typed-slot storage the element is written using the header's `elem_size`, so a `Vec[U8]` writes exactly one byte per slot (8x smaller than the old word-per-slot layout).
##see Vec.get, Vec.push, VEC_HEADER_V2, vec_typed_slot
##example
let mut v: Vec[U8] = Vec.with_capacity(4);
v.push(1u8);
v.push(2u8);
v.set(0, 9u8);
assert_eq(v.get(0), Some(&9u8));
##end

##sym Vec.contains
##sig fn Vec.contains[T: PartialEq](&self, needle: &T) -> Bool
##desc Linear scan — true iff any element equals `needle` by `PartialEq`. O(n). Use a `HashSet` for hot lookups.
##see Vec.iter, HashSet.contains, Iterator.any
##example
if allow.contains(&"GET") { /* ok */ }
##end

##sym Vec.sort
##sig fn Vec.sort[T: Ord](&mut self)
##desc In-place stable sort by `Ord`. O(n log n). The stable variant preserves original order for equal items.
##see Vec.sort_by, Vec.sort_by_key, Iterator.collect
##example
let mut v = [3, 1, 4, 1, 5];
v.sort();
assert_eq(v, [1, 1, 3, 4, 5]);
##end

##sym Vec.sort_by
##sig fn Vec.sort_by[T](&mut self, cmp: fn(&T, &T) -> Ordering)
##desc In-place stable sort with a user comparator. Use for custom orderings or sort-by-projection-without-`Ord`.
##see Vec.sort, Vec.sort_by_key
##example
v.sort_by(|a, b| b.priority.cmp(&a.priority));  // descending
##end

##sym Vec.reverse
##sig fn Vec.reverse(&mut self)
##desc In-place reverse. O(n). Equivalent to `.iter().rev().collect()` but does not allocate.
##see Iterator.rev, Vec.sort
##example
let mut v = [1, 2, 3];
v.reverse();
assert_eq(v, [3, 2, 1]);
##end

##sym Vec.retain
##sig fn Vec.retain[T](&mut self, pred: fn(&T) -> Bool)
##desc Drop every element where `pred` returns `false`. In-place, preserves order. O(n) — one pass.
##see Iterator.filter, Vec.iter, Vec.clear
##example
let mut v = [1, 2, 3, 4, 5];
v.retain(|x| x % 2 == 0);
assert_eq(v, [2, 4]);
##end

##sym Vec.extend
##sig fn Vec.extend[T, I: Iterator[T]](&mut self, items: I)
##desc Append every item from `items`. Amortised O(n) — reserves up front when the iterator reports a size hint.
##see Vec.append, Vec.push, Iterator.collect
##example
let mut v = vec![1, 2];
v.extend([3, 4].iter().copied());
assert_eq(v, [1, 2, 3, 4]);
##end

