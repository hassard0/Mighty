##sym std.json.parse
##sig fn std.json.parse(s: Str) -> Result<Json, JsonError>
##desc Parses a JSON string into the dynamic `Json` value type.
##see std.json.encode, std.json.encode_pretty
##example
let j = std.json.parse(body)?;
