##sym std.env.args
##sig fn std.env.args() -> List<Str>
##desc Returns the CLI's `--`-tail positional arguments.
##see log
##example
let args = std.env.args();
log(format!("argc={}", args.len()));
##end

# concept-doc
##sym MTY_LINKER
##sig env var MTY_LINKER=<path-or-name>
##desc Picks the native linker `mty build` invokes (e.g. `clang`, `lld`, full path to `link.exe`). Falls back to the legacy `STARDUST_LINKER` spelling. When unset, the cranelift backend writes the object file and reports `no linker found`.
##see MTY_TRACE, MTY_OTLP_ENDPOINT, MTY_RUNTIME_THREADS
##example
// Pick clang explicitly:
//   MTY_LINKER=clang mty build app.mty
// Legacy alias still honoured:
//   STARDUST_LINKER=lld mty build app.mty
##end

# concept-doc
##sym MTY_OTLP_ENDPOINT
##sig env var MTY_OTLP_ENDPOINT=<grpc-url>
##desc Enables the OTLP telemetry exporter. When set, the runtime ships spans to the given gRPC collector (default port 4317). Falls back to the legacy `STARDUST_OTLP_ENDPOINT` spelling.
##see MTY_TRACE, MTY_LINKER, observe.otel_sink
##example
// Boot with OpenTelemetry export:
//   MTY_OTLP_ENDPOINT=http://localhost:4317 mty run app.mty
##end

# concept-doc
##sym MTY_TRACE
##sig env var MTY_TRACE=stderr|file:<path>
##desc Selects the runtime's NDJSON telemetry sink. `stderr` for inline debugging, `file:<path>` for an append-only log. Overridden when `MTY_OTLP_ENDPOINT` is set. Legacy `STARDUST_TRACE` honoured.
##see MTY_OTLP_ENDPOINT, MTY_LINKER, observe.record
##example
// MTY_TRACE=stderr mty run app.mty
// MTY_TRACE=file:./run.ndjson mty run app.mty
##end

# concept-doc
##sym MTY_RUNTIME_THREADS
##sig env var MTY_RUNTIME_THREADS=<N>
##desc Per-worker scheduler count. Default 1 (single-threaded executor). Legacy `STARDUST_RUNTIME_THREADS` honoured.
##see MTY_TRACE, MTY_RUNTIME_CONTROL_SOCK
##example
// MTY_RUNTIME_THREADS=4 mty run app.mty
##end

# concept-doc
##sym MTY_RUNTIME_CONTROL_SOCK
##sig env var MTY_RUNTIME_CONTROL_SOCK=<path>
##desc Boots a Unix-domain control socket for the runtime so `mty inspect` (and the replay tooling) can attach without restart. No legacy spelling — introduced at the renamed name in v0.16.
##see MTY_RUNTIME_THREADS, MTY_TRACE
##example
// MTY_RUNTIME_CONTROL_SOCK=/tmp/mty.sock mty run app.mty
// mty inspect --sock /tmp/mty.sock
##end

