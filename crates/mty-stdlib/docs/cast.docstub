##module cast
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym cast_as
##sig expr as Ty
##desc Scalar cast operator. Accepted for numeric widening / narrowing, signedness flips, `Bool→U8`, `Char→U32`, and pointer↔USize. Other shapes emit MT2027 at type-check time.
##see cast_u8_to_i64, cast_invalid_mt2027, cast_f32_to_f64
##example
let n: I64 = 42;
let b: U8 = n as U8;
let f: F64 = n as F64;
##end

##sym cast_u8_to_i64
##sig u8_expr as I64
##desc Zero-extend an unsigned byte to a 64-bit signed integer. Always lossless because U8's range fits in I64.
##see cast_as, cast_i64_to_u8, cast_usize_to_u64
##example
let byte: U8 = 0xFF;
let wide: I64 = byte as I64;
assert_eq(wide, 255);
##end

##sym cast_i64_to_u8
##sig i64_expr as U8
##desc Narrowing cast: truncates to the low 8 bits. Sign / overflow is silently dropped — no MT2027 because the cast is structurally well-formed; the lossy behaviour is intentional.
##see cast_as, cast_u8_to_i64
##example
let big: I64 = 257;
let small: U8 = big as U8;
assert_eq(small, 1);
##end

##sym cast_f32_to_f64
##sig f32_expr as F64
##desc Widen single-precision to double-precision float. Always lossless.
##see cast_as, cast_f64_to_f32, cast_i32_to_f32
##example
let x: F32 = 1.5;
let y: F64 = x as F64;
##end

##sym cast_f64_to_f32
##sig f64_expr as F32
##desc Narrow double to single precision. May round; values outside F32's range produce `+inf` / `-inf`.
##see cast_as, cast_f32_to_f64
##example
let x: F64 = 3.141592653589793;
let y: F32 = x as F32;
##end

##sym cast_i32_to_f32
##sig i32_expr as F32
##desc Int-to-float cast. Lossless for |n| ≤ 2^24; larger magnitudes round to the nearest representable F32.
##see cast_as, cast_f32_to_i32, cast_f32_to_f64
##example
let n: I32 = 1000;
let f: F32 = n as F32;
##end

##sym cast_f32_to_i32
##sig f32_expr as I32
##desc Float-to-int truncation toward zero. NaN→0, ±inf saturate to I32::MIN/MAX (LLVM `fptosi.sat`).
##see cast_as, cast_i32_to_f32
##example
let f: F32 = 3.7;
let n: I32 = f as I32;
assert_eq(n, 3);
##end

##sym cast_usize_to_u64
##sig usize_expr as U64
##desc Platform-pointer-width to fixed 64-bit width. Identity on 64-bit hosts; zero-extends on 32-bit hosts.
##see cast_as, cast_u8_to_i64, cast_ptr_to_usize
##example
let n: USize = 1024;
let w: U64 = n as U64;
##end

##sym cast_bool_to_u8
##sig bool_expr as U8
##desc `true→1`, `false→0`. Bool ↔ any int width is accepted as of v0.39 T2 (the reverse `IntN as Bool` follows `0 → false`, nonzero → `true` and lowers to `icmp ne 0`); `Bool as Float` and `Float as Bool` still emit MT2027.
##see cast_as, cast_int_to_bool, cast_invalid_mt2027
##example
let flag: Bool = true;
let n: U8 = flag as U8;
assert_eq(n, 1);
let round_trip: Bool = (n as I32) as Bool;
assert_eq(round_trip, true);
##end

##sym cast_int_to_bool
##sig int_expr as Bool
##desc v0.39 T2 — `0 → false`, any nonzero → `true`. The cranelift back-end emits an `icmp ne 0` (not a low-byte truncate), so `256_i32 as Bool` correctly yields `true`. `Float as Bool` is deliberately rejected — use the explicit predicate `x != 0.0 && !x.is_nan()`.
##see cast_as, cast_bool_to_u8, cast_invalid_mt2027
##example
let n: I32 = 256;
let truthy: Bool = n as Bool;
assert_eq(truthy, true);
let zeroish: Bool = 0_i32 as Bool;
assert_eq(zeroish, false);
##end

##sym cast_char_to_u32
##sig char_expr as U32
##desc Code-point integer value of a `Char`. ASCII `'A'` → 65, BMP `'©'` → 169.
##see cast_as, cast_int_to_char, String.chars
##example
let c: Char = 'A';
let code: U32 = c as U32;
assert_eq(code, 65);
##end

##sym cast_int_to_char
##sig int_expr as Char
##desc Integer-to-codepoint cast. Literals are checked at compile time against the Unicode scalar value range (0..0x110000 minus the UTF-16 surrogate gap 0xD800..=0xDFFF); out-of-range literals emit MT2028 INVALID_CODEPOINT. Non-literal sources currently pass typeck and produce the raw bit pattern — v0.40 will tighten this with either a runtime trap or an `Option[Char]` surface (see docs/reference/casts.md).
##see cast_as, cast_char_to_u32, cast_invalid_mt2028
##example
let a: Char = 0x41 as Char;       // 'A' — ok
let hi: Char = 0xD7FF as Char;    // last value before surrogate gap
// let bad: Char = 0xD800 as Char; // MT2028 INVALID_CODEPOINT
##end

##sym cast_ref_to_ptr
##sig &T as *T
##desc v0.39 T2 — explicit reference cast. Promotes the v0.37 T3 extern-c `coerce_addr_of` path to a general surface so authors can spell `&x as *I32` outside an FFI call site. The inner types must unify (`&I32 as *U8` emits MT2027); pointer-to-integer round-trips are NOT allowed via `as`, use `unsafe { raw_ptr(addr) }` instead. `*const T` and `*mut T` collapse onto a single `TyData::Ref` shape at typeck (slice-1 simplification).
##see cast_as, addr_of_local, coerce_str_to_u8
##example
let x: I32 = 42;
let p: *I32 = &x as *I32;
##end

##sym cast_invalid_mt2028
##sig MT2028 INVALID_CODEPOINT
##desc v0.39 T2 type-check error for a literal `Int as Char` cast whose value is outside the Unicode scalar value range (0..0x110000) or in the UTF-16 surrogate gap 0xD800..=0xDFFF. Mighty's `Char` is a Unicode scalar value; allowing an out-of-range literal would corrupt UTF-8 invariants when the value flowed into a String.
##see cast_int_to_char, cast_char_to_u32, cast_invalid_mt2027
##example
// MT2028: 0x110000 sits one past the top of the scalar-value range
let bad1: Char = 0x110000 as Char; // ERROR
// MT2028: surrogate gap is reserved
let bad2: Char = 0xD800 as Char;   // ERROR
##end

##sym cast_ptr_to_usize
##sig *Ty as USize  (deferred — MT2027 today)
##desc Pointer↔integer round-tripping via the `as` surface is NOT accepted (MT2027). v0.39 T2's reference-cast rule (`&T as *T`, see cast_ref_to_ptr) stops at the pointer level on purpose. Use the existing `unsafe { raw_ptr(addr) }` builtin to bridge the integer→pointer side; the pointer→integer side is reserved for a future `unsafe { addr_of(p) }` builtin. This entry remains in the docstub stream so future tooling/tests can surface the gap; v0.40 may promote it to a working slot.
##see cast_as, cast_ref_to_ptr, addr_of_local
##example
// Reserved — does NOT compile today (emits MT2027):
//   let p: *U8 = ...;
//   let addr: USize = p as USize;
// Bridge via the unsafe builtin instead:
//   let p: *U8 = unsafe { raw_ptr(addr) };
##end

##sym cast_invalid_mt2027
##sig MT2027 INVALID_CAST
##desc Type-check error emitted when `expr as Ty` is not on the recognised scalar-conversion table. Example: `"hi" as I32`, `Vec[I32] as USize`, or `Bool as F64`.
##see cast_as, cast_bool_to_u8, cast_char_to_u32
##example
// MT2027: invalid cast — Str has no scalar projection to I32
let s: Str = "hi";
let n: I32 = s as I32; // ERROR
##end

