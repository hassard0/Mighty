##module string
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym String.new
##sig fn String.new() -> String
##desc Allocates an empty owned UTF-8 string.
##see String.from_str, String.with_capacity
##example
let mut s = String.new();
s.push_str("hi");
##end

##sym String.from_str
##sig fn String.from_str(s: Str) -> String
##desc Owned copy of the borrowed slice `s`.
##see String.new, String.push_str
##example
let owned = String.from_str("hi");
##end

##sym String.push_str
##sig fn String.push_str(&mut self, s: Str) -> Unit
##desc Appends `s` to the end of this string.
##see String.new, String.from_str
##example
s.push_str(" world");
##end

##sym String.with_capacity
##sig fn String.with_capacity(n: USize) -> String
##desc Pre-allocate a string buffer for `n` bytes. Avoids re-allocs in a hot build loop.
##see String.new, String.from_str, String.push_str
##example
let mut s = String.with_capacity(64);
s.push_str("hi");
##end

##sym String.len
##sig fn String.len(&self) -> USize
##desc Byte length. NOT the char count — `"a©"` has `len() == 3` because `©` is a 2-byte UTF-8 sequence.
##see String.is_empty, String.as_bytes
##example
let n = String.from_str("hello").len();
assert_eq(n, 5);
##end

##sym String.is_empty
##sig fn String.is_empty(&self) -> Bool
##desc True if the string has zero bytes. Same as `len() == 0`.
##see String.len, String.clear
##example
let s = String.new();
assert(s.is_empty());
##end

##sym String.push
##sig fn String.push(&mut self, c: Char)
##desc Append a single character. UTF-8-aware: a single `Char` may add up to 4 bytes.
##see String.push_str, String.clear
##example
let mut s = String.new();
s.push('h');
s.push('i');
##end

##sym String.clear
##sig fn String.clear(&mut self)
##desc Reset length to zero without releasing capacity. Build-and-clear loops avoid re-allocations.
##see String.push_str, String.with_capacity
##example
let mut s = String.with_capacity(64);
s.push_str("draft");
s.clear();
##end

##sym String.as_bytes
##sig fn String.as_bytes(&self) -> &[U8]
##desc Borrow the raw UTF-8 bytes. Useful for hashing / network framing where you want bytes, not chars.
##see String.len, String.into_bytes
##example
let s = String.from_str("hi");
let bs = s.as_bytes();
assert_eq(bs.len(), 2);
##end

##sym format
##sig macro format!(fmt: Str, args: ...) -> Str
##desc `println`-style formatter. Returns a `Str`; non-allocating for the literal-only case.
##see log, String.push_str
##example
let s = format!("score: {}, level: {}", 42, 7);
log(s);
##end

##sym String.find
##sig fn String.find(&self, needle: Str) -> Option[USize]
##desc Byte index of the first occurrence of `needle`, or `None`. Mirrors `str::find`.
##see String.rfind, String.position, String.contains
##example
let s = "Hello, Mighty";
let pos = s.find("Mighty");
assert_eq(pos, Some(7));
##end

##sym String.rfind
##sig fn String.rfind(&self, needle: Str) -> Option[USize]
##desc Byte index of the last occurrence of `needle`, or `None`.
##see String.find, String.position
##example
let pos = "ababab".rfind("ab");
assert_eq(pos, Some(4));
##end

##sym String.position
##sig fn String.position(&self, c: Char) -> Option[USize]
##desc Byte index of the first occurrence of code-point `c`, or `None`. Cheaper than `find(&c.to_string())` for single-`Char` lookups.
##see String.find, String.chars
##example
let p = "h©llo".position('©');
assert_eq(p, Some(1));
##end

##sym String.insert_at
##sig fn String.insert_at(&self, idx: USize, t: Str) -> Option[Str]
##desc Splice `t` into this string at byte position `idx`. Returns `None` (MT5080) when `idx` is past the end or is not a UTF-8 code-point boundary.
##see String.remove_range, String.replace_range, String.is_char_boundary
##example
let s = "Hello, Mighty";
let r = s.insert_at(7, "the ");
assert_eq(r, Some("Hello, the Mighty"));
##end

##sym String.remove_range
##sig fn String.remove_range(&self, start: USize, end: USize) -> Option[Str]
##desc Delete the byte range `start..end`. Returns `None` (MT5080) when bounds are inverted, out of range, or not on UTF-8 boundaries.
##see String.replace_range, String.insert_at, String.is_char_boundary
##example
let s = "Hello, the Mighty";
let r = s.remove_range(7, 11);
assert_eq(r, Some("Hello, Mighty"));
##end

##sym String.replace_range
##sig fn String.replace_range(&self, start: USize, end: USize, t: Str) -> Option[Str]
##desc Replace the byte range `start..end` with `t`. Returns `None` (MT5080) on bad bounds.
##see String.remove_range, String.insert_at, String.replace
##example
let s = "Hello, the Mighty";
let r = s.replace_range(7, 11, "a ");
assert_eq(r, Some("Hello, a Mighty"));
##end

##sym String.is_char_boundary
##sig fn String.is_char_boundary(&self, idx: USize) -> Bool
##desc True iff `idx` is a UTF-8 code-point boundary (including `0` and `byte_len()`). False inside multi-byte sequences and past the end.
##see String.next_char_boundary, String.prev_char_boundary
##example
assert(!"é".is_char_boundary(1));
##end

##sym String.next_char_boundary
##sig fn String.next_char_boundary(&self, idx: USize) -> Option[USize]
##desc Smallest UTF-8 code-point boundary strictly greater than `idx`, or `None` if `idx >= byte_len()`.
##see String.is_char_boundary, String.prev_char_boundary
##example
assert_eq("a©b".next_char_boundary(2), Some(3));
##end

##sym String.prev_char_boundary
##sig fn String.prev_char_boundary(&self, idx: USize) -> Option[USize]
##desc Largest UTF-8 code-point boundary strictly less than `idx`, or `None` if `idx == 0`.
##see String.is_char_boundary, String.next_char_boundary
##example
assert_eq("a©b".prev_char_boundary(2), Some(1));
##end

##sym String.chars
##sig fn String.chars(&self) -> Iterator[Char]
##desc Iterator over Unicode code points. Lazy: no intermediate `Vec<Char>` allocation.
##see String.char_indices, String.bytes
##example
let n = "a©🦀".chars().len();
assert_eq(n, 3);
##end

##sym String.char_indices
##sig fn String.char_indices(&self) -> Iterator[(USize, Char)]
##desc Iterator over `(byte_index, char)` pairs.
##see String.chars, String.as_bytes
##example
let pairs = "a©b".char_indices();
assert_eq(pairs.len(), 3);
##end

##sym String.byte_len
##sig fn String.byte_len(&self) -> USize
##desc Documented byte-length alias of `len`. Spells out "I want bytes" at the call site.
##see String.len, String.as_bytes
##example
assert_eq("a©".byte_len(), 3);
##end

##sym String.split
##sig fn String.split(&self, sep: Str) -> Iterator[Str]
##desc Lazy iterator of substrings separated by `sep`. Empty `sep` yields a `Char`-wide split (one item per code point). Trailing empties are preserved.
##see String.splitn, String.find, String.trim
##example
let parts: Vec[Str] = "a,b,,c".split(",").collect();
assert_eq(parts, ["a", "b", "", "c"]);
##end

##sym String.trim
##sig fn String.trim(&self) -> Str
##desc Borrow a sub-string with leading + trailing whitespace removed. Whitespace follows the Unicode White_Space property.
##see String.trim_end, String.trim_start, String.split
##example
let s = "  hello world  \n".trim();
assert_eq(s, "hello world");
##end

##sym String.starts_with
##sig fn String.starts_with(&self, prefix: Str) -> Bool
##desc True iff `self` starts with `prefix`. O(prefix.len()).
##see String.ends_with, String.find
##example
if s.starts_with("https://") { /* secure */ }
##end

##sym String.ends_with
##sig fn String.ends_with(&self, suffix: Str) -> Bool
##desc True iff `self` ends with `suffix`. O(suffix.len()).
##see String.starts_with, String.find
##example
if path.ends_with(".mty") { compile(path); }
##end

##sym String.contains
##sig fn String.contains(&self, needle: Str) -> Bool
##desc True iff `needle` occurs anywhere inside `self`. Use `find` if you also need the offset.
##see String.find, String.starts_with, String.ends_with
##example
if body.contains("ERROR") { alert(); }
##end

##sym String.to_lowercase
##sig fn String.to_lowercase(&self) -> String
##desc Allocate a lowercase copy. Honors Unicode special casing — `'İ'.to_lowercase()` yields `"i̇"` (two code points). Use `to_ascii_lowercase` for ASCII-only.
##see String.to_uppercase, String.trim
##example
if email.to_lowercase() == canonical { /* match */ }
##end

##sym String.to_uppercase
##sig fn String.to_uppercase(&self) -> String
##desc Allocate an uppercase copy. Honors Unicode special casing.
##see String.to_lowercase, String.trim
##example
let shout = greeting.to_uppercase();
##end

