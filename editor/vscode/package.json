{
  "name": "mighty",
  "displayName": "Mighty",
  "description": "Mighty language support (syntax + LSP) for VS Code. v0.8 adds cross-file rename / go-to-def via the workspace resolve map.",
  "version": "0.8.0",
  "publisher": "mighty-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/hassard0/Mighty.git",
    "directory": "editor/vscode"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "activationEvents": [
    "onLanguage:mighty"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "mighty",
        "aliases": [
          "Mighty",
          "mty"
        ],
        "extensions": [
          ".mty"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mighty",
        "scopeName": "source.mty",
        "path": "./syntaxes/mighty.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "mighty.restartServer",
        "title": "Mighty: Restart Language Server"
      }
    ],
    "keybindings": [
      {
        "command": "editor.action.rename",
        "key": "f2",
        "when": "editorTextFocus && editorLangId == mighty"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "mighty",
        "scopes": {
          "macro": ["entity.name.function.macro.mighty"],
          "property": ["variable.other.property.mighty"]
        }
      }
    ],
    "configuration": {
      "title": "Mighty",
      "properties": {
        "mighty.server.path": {
          "type": "string",
          "default": "mty",
          "description": "Path to the `mty` binary. The extension launches `<path> lsp` over stdio."
        },
        "mighty.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the Mighty LSP."
        },
        "mighty.inlayHints.enable": {
          "type": "boolean",
          "default": false,
          "description": "Show inferred-type hints next to `let` bindings and fn parameters. Off by default — toggle on if you prefer them visible."
        },
        "mighty.semanticTokens.enable": {
          "type": "boolean",
          "default": true,
          "description": "Use the LSP's semantic-token classifier to highlight identifiers (functions, types, parameters, etc.) more precisely than the TextMate grammar can."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.3.0",
    "@vscode/vsce": "^2.21.0"
  }
}
