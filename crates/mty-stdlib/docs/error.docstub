##module error
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Error.trait
##sig trait Error: Display + Debug { fn source(&self) -> Option[&dyn Error] { None } }
##desc Common interface for typed error values. Implementations carry a `Display` impl for human-readable messages and an optional `source()` chain. Mirrors `std::error::Error`.
##see Result.map_err, anyhow_error
##example
impl Error for AppError {
  fn source(&self) -> Option[&dyn Error] {
    match self {
      AppError.Io(e) => Some(e),
      _ => None,
    }
  }
}
##end

##sym anyhow_error
##sig macro anyhow!(fmt: Str, args: ...) -> AnyhowError
##desc Construct an `AnyhowError` from a format string (anyhow-style ergonomics). The error carries a stringified message and the `?`-chain backtrace.
##see Error.trait, Result.map_err, panic
##example
if !port_ok { return Err(anyhow!("bad port: {}", port)); }
##end

##sym AnyhowError.context
##sig fn AnyhowError.context(self, msg: Str) -> AnyhowError
##desc Attach a description to the error chain (Rust-anyhow style). Walks the existing `source()` chain so the formatted output reads top-down: outer context → root cause.
##see Error.trait, anyhow_error, Result.map_err
##example
let cfg = read_config(path).map_err(|e| AnyhowError.from(e).context("reading config"))?;
##end

##sym Error.source
##sig fn Error.source(&self) -> Option[&dyn Error]
##desc Walk the error chain — return the immediate cause, or `None` if this is a root error. Drives the multi-line `{:?}` debug formatter and the `AnyhowError.context` chain.
##see Error.trait, AnyhowError.context, anyhow_error
##example
let mut err: &dyn Error = &my_err;
while let Some(cause) = err.source() {
  log(format!("caused by: {}", cause));
  err = cause;
}
##end

