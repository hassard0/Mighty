{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mighty",
  "scopeName": "source.mty",
  "fileTypes": ["mty"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#decorators" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#taint" },
    { "include": "#agent-decl" },
    { "include": "#protocol-decl" },
    { "include": "#fn-decl" },
    { "include": "#type-decl" },
    { "include": "#capability-block" },
    { "include": "#effect-block" },
    { "include": "#budget-block" },
    { "include": "#arena-block" },
    { "include": "#keywords" },
    { "include": "#soft-keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.mighty",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.mighty",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mighty",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.mighty",
          "begin": "#\\[",
          "end": "\\]",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.mighty" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.mighty" }
          },
          "patterns": [
            { "include": "#strings" },
            { "include": "#numbers" },
            {
              "name": "entity.other.attribute-name.mighty",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "meta.decorator.mighty",
          "match": "(@)(tool|computer_use|computeruse|agent|protocol|capability|effect|test|eval|replay|cache|memoize|deterministic|sandbox|capability_check|budget|trace|policy|mcp|llm|prompt|persona|deprecated|inline|cold|hot|export|public)\\b",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.mighty" },
            "2": { "name": "entity.name.function.decorator.mighty" }
          }
        },
        {
          "name": "meta.decorator.mighty",
          "match": "(@)([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.definition.decorator.mighty" },
            "2": { "name": "entity.name.function.decorator.mighty" }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.html.mighty",
          "begin": "html\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mighty",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.raw.mighty",
          "begin": "r#*\"",
          "end": "\"#*"
        },
        {
          "name": "string.quoted.double.mighty",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mighty",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt0\\\\\"'])"
            },
            {
              "name": "meta.interpolation.mighty",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.definition.interpolation.begin.mighty" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.definition.interpolation.end.mighty" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.mighty",
          "match": "'([^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.mighty",
          "match": "\\b[0-9_]+(ns|us|ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.size.mighty",
          "match": "\\b[0-9_]+(KiB|MiB|GiB|TiB|B|k|M|G)\\b"
        },
        {
          "name": "constant.numeric.hex.mighty",
          "match": "\\b0x[0-9A-Fa-f_]+([iuf](8|16|32|64|128))?\\b"
        },
        {
          "name": "constant.numeric.oct.mighty",
          "match": "\\b0o[0-7_]+([iuf](8|16|32|64|128))?\\b"
        },
        {
          "name": "constant.numeric.bin.mighty",
          "match": "\\b0b[01_]+([iuf](8|16|32|64|128))?\\b"
        },
        {
          "name": "constant.numeric.float.mighty",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.mighty",
          "match": "\\b[0-9][0-9_]*([iuf](8|16|32|64|128))?\\b"
        }
      ]
    },
    "taint": {
      "patterns": [
        {
          "name": "invalid.illegal.taint.mighty",
          "match": "\\b(tainted|untrusted|llm_output|user_input)\\b"
        },
        {
          "name": "markup.italic.taint-marker.mighty",
          "match": "(?<![A-Za-z0-9_])(#tainted|#untrusted|#llm)(?![A-Za-z0-9_])"
        }
      ]
    },
    "agent-decl": {
      "match": "\\b(agent|sup|supervisor)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.agent.mighty" },
        "2": { "name": "entity.name.type.agent.mighty" }
      }
    },
    "protocol-decl": {
      "match": "\\b(protocol)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.protocol.mighty" },
        "2": { "name": "entity.name.type.protocol.mighty" }
      }
    },
    "fn-decl": {
      "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.fn.mighty" },
        "2": { "name": "entity.name.function.mighty" }
      }
    },
    "type-decl": {
      "match": "\\b(struct|enum|type|trait|impl)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.type.mighty" },
        "2": { "name": "entity.name.type.mighty" }
      }
    },
    "capability-block": {
      "match": "\\b(cap|capability)\\b",
      "name": "keyword.declaration.capability.mighty"
    },
    "effect-block": {
      "match": "\\b(effect)\\b",
      "name": "keyword.declaration.effect.mighty"
    },
    "budget-block": {
      "match": "\\b(budget)\\s*\\{",
      "captures": {
        "1": { "name": "keyword.declaration.budget.mighty" }
      }
    },
    "arena-block": {
      "match": "\\b(arena)\\b",
      "name": "keyword.declaration.arena.mighty"
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mighty",
          "match": "\\b(if|else|match|for|while|loop|return|in|yield|await|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.mighty",
          "match": "\\b(fn|struct|enum|type|trait|impl|agent|protocol|supervisor|sup|macro|const|mod|use|import|package|extern|export|sandbox|state|on|child|on_fail|restart|backoff|up_to)\\b"
        },
        {
          "name": "keyword.modifier.mighty",
          "match": "\\b(pub|mut|ref|move|unsafe|async|spawn|task|detach|join|scope|run|arena|with|where|requires|derive|dyn|cap|effect|as)\\b"
        },
        {
          "name": "variable.language.self.mighty",
          "match": "\\bself\\b"
        },
        {
          "name": "storage.type.mighty",
          "match": "\\b(let)\\b"
        },
        {
          "name": "constant.language.bool.mighty",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "constant.language.unit.mighty",
          "match": "\\b(nil|null|none|None|Some|Ok|Err)\\b"
        }
      ]
    },
    "soft-keywords": {
      "patterns": [
        {
          "name": "keyword.other.soft.mighty",
          "match": "\\b(budget|emit|loose|strict|warn|deny|allow|require|grant|revoke|policy|mcp)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.mighty",
          "match": "\\b(Bool|Char|Str|String|Bytes|Unit|Never|Duration|Size|I8|I16|I32|I64|I128|U8|U16|U32|U64|U128|ISize|USize|F32|F64|Result|Option|Vec|Map|Set|HashMap|HashSet|BTreeMap|BTreeSet|Arc|Rc|Box|Cow|Path|PathBuf)\\b"
        },
        {
          "name": "entity.name.type.mighty",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "meta.function-call.macro.mighty",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\!",
          "captures": {
            "1": { "name": "entity.name.function.macro.mighty" }
          }
        },
        {
          "name": "meta.function-call.mighty",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.mighty" }
          }
        },
        {
          "name": "meta.path.mighty",
          "match": "\\b([a-z_][A-Za-z0-9_]*)::",
          "captures": {
            "1": { "name": "entity.name.namespace.mighty" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.mighty",
          "match": "(\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=)"
        },
        {
          "name": "keyword.operator.comparison.mighty",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.mighty",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.mighty",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.range.mighty",
          "match": "(\\.\\.=|\\.\\.)"
        },
        {
          "name": "keyword.operator.arrow.mighty",
          "match": "(=>|->)"
        },
        {
          "name": "keyword.operator.path.mighty",
          "match": "(::)"
        },
        {
          "name": "keyword.operator.borrow.mighty",
          "match": "(&mut\\s|&)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.mighty", "match": ";" },
        { "name": "punctuation.separator.comma.mighty", "match": "," },
        { "name": "punctuation.separator.colon.mighty", "match": ":" }
      ]
    }
  }
}
