// =====================================================================
// Patterns
// =====================================================================

fn lower_pat(n: USize) -> USize {
  let k = node_kind(n)
  match k {
    "LITERAL_PAT" => std.io.hir_emit_pat("Literal")
    "BINDING_PAT" => std.io.hir_emit_pat("Binding")
    "WILDCARD_PAT" => std.io.hir_emit_pat("Wildcard")
    "TUPLE_PAT" => lower_compound_pat(n, "Tuple")
    "STRUCT_PAT" => lower_compound_pat(n, "Struct")
    "ENUM_PAT" => lower_compound_pat(n, "Enum")
    "RANGE_PAT" => std.io.hir_emit_pat("Range")
    "REF_PAT" => lower_compound_pat(n, "Ref")
    _ => std.io.hir_emit_pat("Wildcard")
  }
}

fn lower_compound_pat(n: USize, tag: Str) -> USize {
  let id = std.io.hir_emit_pat(tag)
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_pat_node_kind(ck) == true {
      let _ = lower_pat(c)
    }
    i = i + 1
  }
  id
}

