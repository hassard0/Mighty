}

fn lower_struct_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("Struct")
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if ck == "STRUCT_EXPR_FIELD" {
      let inner = child_count(c)
      let mut j: USize = 0
      loop {
        if j >= inner { break }
        let cc = nth_child(c, j)
        let cck = node_kind(cc)
        if is_expr_node_kind(cck) == true {
          let _ = lower_expr(cc)
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  id
}

fn lower_block_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("Block")
  let _ = lower_block(n)
  id
}

fn lower_if_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("If")
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_expr_node_kind(ck) == true {
      let _ = lower_expr(c)
    } else if ck == "BLOCK_EXPR" {
      let _ = lower_block_expr(c)
    }
    i = i + 1
  }
  id
}

fn lower_match_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("Match")
  let nc = child_count(n)
  let mut i: USize = 0
  let mut scrut_done = false
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_expr_node_kind(ck) == true {
      if scrut_done == false {
        let _ = lower_expr(c)
        scrut_done = true
      }
    } else if ck == "MATCH_ARM" {
      let _ = lower_match_arm(c)
    }
    i = i + 1
  }
  id
}

fn lower_match_arm(n: USize) -> USize {
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_pat_node_kind(ck) == true {
      let _ = lower_pat(c)
    } else if is_expr_node_kind(ck) == true {
      let _ = lower_expr(c)
    }
    i = i + 1
  }
  0
}

fn lower_for_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("For")
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_pat_node_kind(ck) == true {
      let _ = lower_pat(c)
    } else if is_expr_node_kind(ck) == true {
      let _ = lower_expr(c)
    } else if ck == "BLOCK_EXPR" {
      let _ = lower_block_expr(c)
    }
    i = i + 1
  }
  id
}

