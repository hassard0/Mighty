// Private helper (leading `_` keeps it out of the Wasm Component
// world export list; the example focus is the match expression).
fn _classify(n: I32) -> Str {
  match n {
    0 => "zero"
    1..10 => "small"
    _ => "big"
  }
}

fn main() {
  // v0.42 T4 (L23 fix) — native codegen now lowers `log()` for any
  // computed value via a typed runtime surface
  // (`mty_runtime_log_*` + per-scalar `to_str()`). The Str return
  // from `_classify` interleaves with the next call, so we log
  // each classification before reading the next (avoids a known
  // codegen issue where Str returns alias the callee's stack
  // slot — separate work item, not in v0.42 T4 scope).
  log(_classify(0))
  log(_classify(7))
  log(_classify(42))
  log("05_match_expr")
}
