// `mty:web/agent@0.1` — composite world wiring `canvas`, `input`,
// and the existing `mighty:log` import together.
//
// This world is the *target* shape a Mighty agent compiled with
// `--target=wasm32-web` lowers into. Track A (codegen) emits the
// `import mty:web/canvas;` / `import mty:web/input;` / `import
// mty:web/log;` lines into the per-pkg world generated by `wit.rs`,
// and the host-side host shim (Track D) implements all three.
//
// The exports below name the *callbacks* the host invokes:
//   * `frame(dt-ms)` after every `request-animation-frame` tick,
//   * `keydown(k)` / `keyup(k)` after every subscribed key event.
//
// The guest's `agent Game(canvas: Canvas, input: Input)` lowering
// matches these export names so the host can dispatch without
// further name-mangling.

package mty:web@0.1;

world agent {
    import canvas;
    import input;
    import log;

    /// Host-invoked next-vsync callback. `dt-ms` is the wall-clock
    /// delta since the previous frame in milliseconds (host-clamped
    /// to a sane range so guests can't trip on tab-switch pauses).
    export frame: func(dt-ms: u32);

    /// Host-invoked keydown callback. The host fills in the raw
    /// `KeyboardEvent.key` string; the guest decodes via
    /// `std.web.Key`.
    export keydown: func(k: string);

    /// Mirror of `keydown` for `keyup` events.
    export keyup: func(k: string);
}

// Re-declare the `mighty:log` interface in the same package so the
// world's `import log` line resolves without pulling in an external
// package. The Mighty-side stdlib already routes `log()` through
// this name on `wasm32-web` (see `crates/mty-stdlib/src/log.rs`).
interface log {
    log: func(msg: string);
}
