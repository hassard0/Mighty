##module path
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Path.new
##sig fn Path.new(s: Str) -> &Path
##desc Borrow `s` as a filesystem path. Cheap — no allocation. The slice is platform-neutral; OS-specific separator handling kicks in on conversion to `PathBuf` or syscall.
##see PathBuf.new, Path.parent, Path.file_name, Path.extension
##example
let p = Path.new("/tmp/build.log");
assert_eq(p.file_name(), Some("build.log"));
##end

##sym PathBuf.new
##sig fn PathBuf.new() -> PathBuf
##desc Allocates an empty owned path. Build with `.push()` / `.join()` and convert to `&Path` via `.as_path()` at syscall sites.
##see Path.new, Path.join, PathBuf.from
##example
let mut p = PathBuf.new();
p.push("/var/log");
p.push("app.log");
##end

##sym Path.components
##sig fn Path.components(&self) -> Iterator[Component]
##desc Iterator over the path's components (root, current dir, parent dir, normal segment). Normalised — collapses runs of separators but preserves `..`.
##see Path.parent, Path.file_name, Path.join
##example
for c in Path.new("/a/b/c").components() { log(format!("{:?}", c)); }
##end

##sym Path.parent
##sig fn Path.parent(&self) -> Option[&Path]
##desc Drop the final component. Returns `None` for root and empty paths.
##see Path.file_name, Path.components, Path.join
##example
assert_eq(Path.new("/a/b/c.txt").parent(), Some(Path.new("/a/b")));
##end

##sym Path.file_name
##sig fn Path.file_name(&self) -> Option[Str]
##desc The final non-separator component, or `None` for a path ending in `..` or `/`.
##see Path.parent, Path.extension, Path.components
##example
assert_eq(Path.new("/etc/hosts").file_name(), Some("hosts"));
##end

##sym Path.extension
##sig fn Path.extension(&self) -> Option[Str]
##desc Bytes after the final `.` of the file name, or `None` if there is no extension (e.g. `Makefile` or `.hidden`).
##see Path.file_name, Path.with_extension
##example
assert_eq(Path.new("main.mty").extension(), Some("mty"));
##end

##sym Path.join
##sig fn Path.join(&self, other: &Path) -> PathBuf
##desc Append `other` with the platform separator. If `other` is absolute, the result is `other` (rooted append wins, matching POSIX semantics).
##see PathBuf.new, Path.parent, Path.with_extension
##example
let p = Path.new("/var/log").join(Path.new("app.log"));
##end

##sym Path.is_absolute
##sig fn Path.is_absolute(&self) -> Bool
##desc True if the path starts with the platform root (`/` on Unix; drive prefix or `\\?\` on Windows).
##see Path.join, Path.parent
##example
assert(Path.new("/etc").is_absolute());
assert(!Path.new("etc").is_absolute());
##end

##sym Path.with_extension
##sig fn Path.with_extension(&self, ext: Str) -> PathBuf
##desc Replace the file extension (or add one when absent). Pass `""` to strip the extension entirely.
##see Path.extension, Path.file_name
##example
let p = Path.new("build.mty").with_extension("o");
assert_eq(p.file_name(), Some("build.o"));
##end

##sym Path.exists
##sig fn Path.exists(&self, cap: FsCap) -> Bool
##cap fs.read
##desc Convenience shorthand for `std.fs.exists(self.as_str(), cap)`. Requires the same `FsCap` as the underlying syscall.
##see std.fs.exists, Path.new, FsCap.rooted
##example
if Path.new("./mighty.toml").exists(FsCap.rooted(".")) { /* ... */ }
##end

##sym PathBuf.push
##sig fn PathBuf.push(&mut self, segment: Str)
##desc Append a path segment, inserting the platform separator if needed. If `segment` is absolute, it replaces the path entirely (matches POSIX `chdir` semantics).
##see PathBuf.new, Path.join, PathBuf.pop
##example
let mut p = PathBuf.new();
p.push("/var");
p.push("log");
p.push("app.log");
assert_eq(p.as_str(), "/var/log/app.log");
##end

##sym PathBuf.pop
##sig fn PathBuf.pop(&mut self) -> Bool
##desc Drop the final component. Returns `true` if a component was removed, `false` if the path was already at root.
##see PathBuf.push, Path.parent
##example
let mut p = PathBuf.from("/a/b/c");
assert(p.pop());
assert_eq(p.as_str(), "/a/b");
##end

##sym PathBuf.set_extension
##sig fn PathBuf.set_extension(&mut self, ext: Str) -> Bool
##desc Replace the file extension. Adds one if absent; strips it if `ext` is empty. Returns `true` if the file-name component was non-empty.
##see Path.with_extension, Path.extension
##example
let mut p = PathBuf.from("build.mty");
p.set_extension("o");
assert_eq(p.as_str(), "build.o");
##end

##sym PathBuf.from
##sig fn PathBuf.from(s: Str) -> PathBuf
##desc Allocate an owned path from a string. Equivalent to `PathBuf.new(); .push(s)`.
##see PathBuf.new, Path.new
##example
let p = PathBuf.from("/etc/hosts");
##end

##sym Path.metadata
##sig fn Path.metadata(&self, cap: FsCap) -> Result[StatResult, IoError]
##cap fs.read
##desc Stat the path. Returns size / kind / mtime in a `StatResult`. Requires `fs.read`.
##see std.fs.stat, Path.exists, StatResult
##example
let md = Path.new("./build.log").metadata(FsCap.rooted("."))?;
log(format!("size={} bytes", md.size));
##end

##sym Path.canonicalize
##sig fn Path.canonicalize(&self, cap: FsCap) -> Result[PathBuf, IoError]
##cap fs.read
##desc Resolve symlinks and `..` segments against the real filesystem. Used to ground a user-supplied path before checking it against an allowlist. Requires `fs.read`.
##see Path.new, std.fs.exists, FsCap.rooted
##example
let real = Path.new("./tmp/../etc").canonicalize(FsCap.rooted("./tmp"))?;
##end

##sym Path.walk
##sig fn Path.walk(&self, cap: FsCap) -> Iterator[Result<DirEntry, IoError>]
##cap fs.read
##desc Recursively iterate every descendant. Yields one `DirEntry` per file + directory in deterministic depth-first order. Skips symlinks by default. Requires `fs.read`.
##see Path.new, std.fs.read_to_string, FsCap.rooted
##example
for entry in Path.new("./src").walk(FsCap.rooted("./src")) {
  let e = entry?;
  if e.path.extension() == Some("mty") { log(e.path.to_string()); }
}
##end

##sym Path.with_file_name
##sig fn Path.with_file_name(&self, name: &Str) -> PathBuf
##desc Return a new path with the final component replaced by `name`. `Path::new("/a/b/c").with_file_name("d")` → `"/a/b/d"`. Useful for sibling-file derivations (e.g. `foo.mty` → `foo.mty.ll`).
##see Path.file_name, Path.with_extension, Path.parent
##example
let out = src.with_file_name("out.ll");
##end

##sym Path.file_stem
##sig fn Path.file_stem(&self) -> Option[&Str]
##desc File name with the final extension removed. `"a/b/c.tar.gz".file_stem()` → `Some("c.tar")` — only the LAST extension is stripped. Use the `file_name` + manual split for full multi-extension handling.
##see Path.file_name, Path.extension, Path.with_extension
##example
let stem = p.file_stem().unwrap_or("");
##end

##sym Path.has_root
##sig fn Path.has_root(&self) -> Bool
##desc Does the path start with a root component (`/` on Unix, drive letter or `\` on Windows)? Distinct from `is_absolute` on Windows where `\foo` has a root but no prefix.
##see Path.is_absolute, Path.is_relative, Path.components
##example
if !p.has_root() { p = cwd.join(&p); }
##end

##sym Path.is_relative
##sig fn Path.is_relative(&self) -> Bool
##desc True iff the path is NOT absolute. Complement of `is_absolute` — never both true.
##see Path.is_absolute, Path.has_root
##example
if p.is_relative() { p = root.join(&p); }
##end

##sym Path.starts_with
##sig fn Path.starts_with(&self, base: impl AsRef[Path]) -> Bool
##desc True iff `self`'s components begin with `base`'s components. Component-wise — `Path::new("/etc/foo").starts_with("/etc")` is true; `"/etcfoo"` is not.
##see Path.components, Path.canonicalize, PathBoundary
##example
if !p.starts_with(&root) { return Err("path-escape"); }
##end

##sym Path.ends_with
##sig fn Path.ends_with(&self, child: impl AsRef[Path]) -> Bool
##desc True iff `self`'s last components match `child`. Component-wise — `"a/b/foo.rs".ends_with("foo.rs")` is true; `"oo.rs"` is not.
##see Path.starts_with, Path.file_name
##example
if p.ends_with("Cargo.toml") { /* ... */ }
##end

