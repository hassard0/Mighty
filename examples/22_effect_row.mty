// 22_effect_row.mty — RFC-008 effect-row surface syntax (v0.16 typeck).
//
// Build:
//   mty fmt examples/22_effect_row.mty
//   mty check examples/22_effect_row.mty
//
// As of v0.16 the parser support (v0.15) is wired through HIR and the
// type checker: the row variable `E` propagates from each closure
// parameter's inferred effect set into the call-site caller's effect
// set, exactly as RFC-008 specifies.
//
// Surface forms (RFC-008 §Syntax):
//
//   * `!E`               — bare row variable (open row, no concrete)
//   * `!{}`              — empty closed row (= today's "pure" fn)
//   * `!{fs, net}`       — concrete closed row (no tail)
//   * `!{fs | E}`        — concrete + row-variable tail
//   * `!{fs, net | E}`   — multiple concrete + row tail
//   * `effect a, b | E`  — legacy keyword form, NEW row-tail extension
//
// The disambiguation rule that keeps `Page!{NetErr, ParseErr}` parsing
// as the legacy anonymous-error-union sugar lives in
// `mty-syntax::parser::types::peeks_as_effect_row_clause`:
//   - first ident inside the braces is UPPERCASE and no `|` present →
//     error sugar (back-compat)
//   - first ident is LOWERCASE, or a `|` appears at depth 0 →
//     effect-row clause

// Bare `!E` form: pure container/closure HOF that threads the closure's
// effect row to the return.
fn observe[E](f: fn() -> Unit) -> Unit !E {
  // Body is intentionally trivial — the contract is the SIGNATURE
  // (closure carries E, return carries E). Real implementations would
  // call `f()` here; v0.16 typeck flows E from the call site.
}

// Concrete + row-tail form: "at least `fs`, plus whatever the closure
// brings". This is the most common shape for higher-order I/O wrappers
// (e.g. a logged-fs-read wrapper).
fn observed_read[E](path: Str, log: fn(Str) -> Unit) -> Str !{fs | E} {
  ""
}

// Plain closed-row form — equivalent to `effect fs` but in the v0.15
// `!{}` shape.
fn read_one(path: Str) -> Str !{fs} {
  ""
}

// Legacy `effect ...` form keeps working unchanged.
fn read_two(path: Str) -> Str effect fs {
  ""
}

// NEW v0.15: the keyword form gains the same `| E` tail extension.
fn read_three[E](path: Str, k: fn(Str) -> Unit) -> Str effect fs | E {
  ""
}

fn main() {
  log("22_effect_row: RFC-008 surface syntax and v0.16 typeck wiring")
}
