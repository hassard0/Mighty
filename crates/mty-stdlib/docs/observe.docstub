##module observe
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Window.parse
##sig fn Window.parse(spec: Str) -> Result<Window, Str>
##desc Parse a Go-style duration spec (`7d`, `12h`, `30m`, `45s`, `500ms`, or `all`). Used by `mty inspect --cost --since`.
##see Window.Last, Window.All, summarize
##example
let w = Window.parse("7d")?;
let sum = summarize(&obs, w, GroupBy.Model, 5);
##end

##sym Window.All
##sig const Window.All: Window
##desc Window covering every observation in the store.
##see Window.Last, Window.parse, summarize
##example
let sum = summarize(&obs, Window.All, GroupBy.Provider, 0);
##end

##sym Window.Last
##sig variant Window.Last { millis: U64 }
##desc Window covering the last `millis` of wall-clock time before now.
##see Window.parse, Window.All
##example
let w = Window.Last { millis: 86400000 };
##end

##sym GroupBy.Provider
##sig const GroupBy.Provider: GroupBy
##desc Group cost rows by provider (anthropic / openai / gemini / bedrock).
##see GroupBy.Model, GroupBy.Agent, GroupBy.None, summarize
##example
let sum = summarize(&obs, Window.All, GroupBy.Provider, 0);
for row in sum.by_group.iter() { log(row.key); }
##end

##sym GroupBy.Model
##sig const GroupBy.Model: GroupBy
##desc Group cost rows by model id (e.g. `claude-opus-4-7`).
##see GroupBy.Provider, GroupBy.Agent, summarize
##example
let sum = summarize(&obs, Window.All, GroupBy.Model, 0);
##end

##sym GroupBy.Agent
##sig const GroupBy.Agent: GroupBy
##desc Group cost rows by `agent_id` so you can compare cost across agent handlers.
##see GroupBy.Provider, GroupBy.Model, summarize
##example
let sum = summarize(&obs, Window.All, GroupBy.Agent, 10);
##end

##sym GroupBy.None
##sig const GroupBy.None: GroupBy
##desc Collapse every call into one synthetic group keyed `"all"`. The bare totals row.
##see GroupBy.Provider, summarize, CostSummary
##example
let sum = summarize(&obs, Window.All, GroupBy.None, 0);
##end

##sym summarize
##sig fn summarize(obs: &[LlmObservation], window: Window, by: GroupBy, top_n: USize) -> CostSummary
##desc Canonical `mty inspect --cost` rollup. Filters by `window`, groups by `by`, and surfaces the top-`n` most-expensive calls.
##see Window.parse, GroupBy.Model, percentiles, aggregate_by
##example
let sum = summarize(&obs, Window.Last { millis: 86400000 }, GroupBy.Model, 5);
log(format!("${:.2}", sum.total_cost_cents as F32 / 100.0));
##end

##sym percentiles
##sig fn percentiles(samples: &[U64]) -> LatencyPercentiles
##desc Compute p50/p95/p99 latency over a slice of millisecond samples. Used by `summarize`.
##see summarize, LatencyPercentiles
##example
let p = percentiles(&latencies);
log(format!("p50={} p99={}", p.p50_ms, p.p99_ms));
##end

##sym aggregate_by
##sig fn aggregate_by(obs: &[&LlmObservation], by: GroupBy) -> Vec[AggregateRow]
##desc Group an observation slice by the chosen key. Returns one row per distinct group with totals.
##see summarize, GroupBy.Provider, AggregateRow
##example
let rows = aggregate_by(&obs.iter().collect::<Vec<_>>(), GroupBy.Provider);
##end

##sym CostSummary
##sig struct CostSummary { window, call_count, total_cost_cents, total_prompt_tokens, total_completion_tokens, latency, by_group, top_calls }
##desc Top-level cost summary surfaced by `mty inspect --cost`. Plain-data shape — safe to JSON-encode.
##see summarize, percentiles, GroupBy.Provider
##example
let s = summarize(&obs, Window.All, GroupBy.None, 0);
log(format!("calls={} cost_cents={}", s.call_count, s.total_cost_cents));
##end

##sym std.observe.percentiles
##sig fn std.observe.percentiles(samples: &[U64]) -> LatencyPercentiles
##desc p50 / p95 / p99 over a slice of latencies in milliseconds. Uses the NEAREST-RANK method (matches the std `summarize` aggregator). Empty input → zeros — the caller can distinguish via `samples.is_empty()`.
##see std.observe.summarize, std.observe.LatencyPercentiles, percentiles
##example
let lats: Vec<U64> = obs.iter().map(|o| o.latency_ms).collect();
let p = std.observe.percentiles(&lats);
log(format("p50={} p95={} p99={}", p.p50_ms, p.p95_ms, p.p99_ms));
##end

##sym std.observe.LatencyPercentiles
##sig struct std.observe.LatencyPercentiles { p50_ms: U64, p95_ms: U64, p99_ms: U64 }
##desc p50 / p95 / p99 latencies across an observation slice. Returned by `percentiles`. Embedded inside `CostSummary` and every `AggregateRow`.
##see std.observe.percentiles, std.observe.CostSummary, std.observe.AggregateRow
##example
let p = std.observe.percentiles(&lats);
assert(p.p50_ms <= p.p95_ms);
assert(p.p95_ms <= p.p99_ms);
##end

##sym std.observe.aggregate_by
##sig fn std.observe.aggregate_by(obs: &[&LlmObservation], by: GroupBy) -> Vec[AggregateRow]
##desc Group observations by `Provider`, `Model`, `Agent`, or `Tenant` and emit one row per group with count, dollar spend, and p50/p95/p99 latency. The companion of `summarize` for breakdowns.
##see aggregate_by, std.observe.summarize, std.observe.AggregateRow, GroupBy.Provider
##example
let rows = std.observe.aggregate_by(&obs, GroupBy.Model);
for row in rows { log(format("{}: ${:.4}", row.label, row.cost_dollars)); }
##end

##sym std.observe.AggregateRow
##sig struct std.observe.AggregateRow { label: Str, count: USize, cost_dollars: F64, p50_latency_ms: U64, p95_latency_ms: U64, p99_latency_ms: U64 }
##desc One row of an `aggregate_by` breakdown: a group label (model name, provider, etc) plus the call count, dollar spend, and latency percentiles for that group.
##see std.observe.aggregate_by, std.observe.CostSummary, std.observe.LatencyPercentiles
##example
for row in std.observe.aggregate_by(&obs, GroupBy.Provider) {
  log(format("{}: {} calls, ${:.2}", row.label, row.count, row.cost_dollars));
}
##end

##sym std.observe.CostSummary
##sig struct std.observe.CostSummary { calls: USize, cost_dollars: F64, latency: LatencyPercentiles, by_provider: Vec[AggregateRow], by_model: Vec[AggregateRow] }
##desc Top-level result of `summarize`: total count + spend, p50/p95/p99 latency, plus per-provider and per-model breakdowns. Drop-in for dashboards and cost emails.
##see CostSummary, std.observe.summarize, std.observe.AggregateRow, std.observe.LatencyPercentiles
##example
let s = std.observe.summarize(&obs, Window.Last("24h"));
log(format("24h spend: ${:.2}", s.cost_dollars));
##end

