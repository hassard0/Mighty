// Demonstrates `use std.json` parses, type-checks, and runs through
// the `sdust run` pipeline. The `json.parse` call routes through the
// runtime's effect-call sink; with the v0.3 driver wiring it will hit
// the real parser, but in v0.2 it returns Unit (no trap).

use std.json

fn main() {
  let v = json.parse("{\"hello\":true}")
  log("parsed")
}
