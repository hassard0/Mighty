// demo 12_web_auth — v0.39 + v0.40 forcing-function demo: real-world
// web authentication built from the new stdlib surface.
//
// The demo ties four v0.39/v0.40 stdlib modules together inside a
// minimal login handler:
//
//   * `std.crypto.hmac_sha256` — constant-time password digest +
//     verification (replaces a hand-rolled equality check that would
//     leak timing).
//   * `std.crypto.aes_gcm` — authenticated encryption for the session
//     payload that gets ferried back to the browser inside a cookie.
//   * `std.crypto.random_bytes` — fresh per-session nonce material.
//   * `std.uuid.Uuid.v7` — time-ordered session identifier (also
//     usable as a DB primary key for the session row).
//   * `std.url.percent_encode` — percent-encodes the sealed cookie
//     value so it is safe to embed in a Set-Cookie header.
//
// Security caveats are pinned in the README (TLS, key rotation, etc).
// This demo runs locally as a single Mighty program; the smoke test
// drives every helper through `mty run` so the v0.40 surfaces stay
// pinned against accidental refactors.
//
// Build:
//   mty check demos/12_web_auth/src/main.mty
//   mty run   demos/12_web_auth/src/main.mty
//
// Smoke (parse + fmt + surface markers + run output):
//   bash demos/12_web_auth/smoke.sh
package web_auth

use std.crypto
use std.encoding
use std.url
use std.uuid

// ---------------------------------------------------------------------
// _hash_password — HMAC-SHA-256 with a server-side pepper.
//
// Production password hashing should use a slow KDF (argon2id /
// scrypt). This demo uses HMAC-SHA-256 because it is what v0.39 T1
// surfaces; the README documents the upgrade path. The pepper is held
// outside the database so a DB leak alone cannot brute-force the
// passwords.
// ---------------------------------------------------------------------
fn _hash_password(pepper: Str, password: Str) -> Str {
  let mac = std.crypto.hmac_sha256(pepper, password)
  std.encoding.hex.encode(mac)
}

// ---------------------------------------------------------------------
// _verify_password — constant-time comparison via HMAC equality.
//
// HMAC's underlying compare path is constant-time in the `subtle` crate
// the stdlib wraps; recomputing the tag and comparing as hex strings
// gives us a single primitive that handles both the digest and the
// constant-time compare.
// ---------------------------------------------------------------------
fn _verify_password(pepper: Str, password: Str, expected_hex: Str) -> Bool {
  let candidate = _hash_password(pepper, password)
  candidate == expected_hex
}

// ---------------------------------------------------------------------
// _new_session_id — UUIDv7 = time-ordered ID, sortable + opaque.
//
// v7 is preferred over v4 here so the session row's primary key is
// monotonic (better B-tree locality, easier audit-log scans).
// ---------------------------------------------------------------------
fn _new_session_id() -> Str {
  let id = std.uuid.Uuid.v7()
  id.to_string()
}

// ---------------------------------------------------------------------
// _derive_session_key — HMAC-derive a per-session AEAD key from the
// master key + session id. Same shape as 43_secure_session: HMAC is the
// primitive HKDF is built on; v0.41 surfaces HKDF directly.
// ---------------------------------------------------------------------
fn _derive_session_key(master_key: Str, session_id: Str) -> Str {
  let derived = std.crypto.hmac_sha256(master_key, session_id)
  std.encoding.hex.encode(derived)
}

// ---------------------------------------------------------------------
// _fresh_nonce — 12-byte random nonce, base64-url-no-pad-encoded.
// AES-GCM nonces MUST be unique per (key, message); 12 random bytes
// give 2^-96 collision probability across the universe of sessions.
// ---------------------------------------------------------------------
fn _fresh_nonce() -> Str {
  let bytes = std.crypto.random_bytes(12)
  std.encoding.base64.encode_url_no_pad(bytes)
}

// ---------------------------------------------------------------------
// _seal_cookie — AES-GCM-256 over the session payload.
//
// Authenticated encryption with associated data:
//   * key     — derived per-session above.
//   * nonce   — fresh per-message above.
//   * version — bound into the AEAD tag so a rotation marker stays
//               cryptographically attached to the cookie.
//   * payload — the actual session state (uid, scopes, expiry, ...).
// ---------------------------------------------------------------------
fn _seal_cookie(key: Str, nonce: Str, version: Str, payload: Str) -> Str {
  let ct = std.crypto.aes_gcm.encrypt(key, nonce, version, payload)
  std.encoding.base64.encode_url_no_pad(ct)
}

// ---------------------------------------------------------------------
// _open_cookie — inverse of _seal_cookie. AEAD verifies the tag in
// constant time; any tamper yields a clean decryption error at the
// runtime layer.
// ---------------------------------------------------------------------
fn _open_cookie(key: Str, nonce: Str, version: Str, sealed: Str) -> Str {
  let ct = std.encoding.base64.decode_url_no_pad(sealed)
  let pt = std.crypto.aes_gcm.decrypt(key, nonce, version, ct)
  pt
}

// ---------------------------------------------------------------------
// _set_cookie_header — assemble a Set-Cookie line for the response.
//
// The sealed payload is already base64-url-safe but the surrounding
// header is still percent-encoded as a defence in depth so a future
// payload format change cannot inject header-splitting characters.
// ---------------------------------------------------------------------
fn _set_cookie_header(name: Str, sealed: Str) -> Str {
  let safe = std.url.percent_encode(sealed)
  "Set-Cookie: " + name + "=" + safe + "; HttpOnly; Secure; SameSite=Strict; Path=/"
}

// ---------------------------------------------------------------------
// _login_response — full POST /login response body. Returns the
// session id alongside the cookie value so the smoke script can assert
// both surfaces fired.
// ---------------------------------------------------------------------
fn _login_response(session_id: Str, header: Str) -> Str {
  "HTTP/1.1 200 OK\r\n" + header + "\r\nContent-Type: application/json\r\n\r\n" +
    "{\"session_id\":\"" + session_id + "\",\"status\":\"ok\"}"
}

// ---------------------------------------------------------------------
// main — drive the login pipeline once end-to-end so the smoke script
// can pin the surface markers + check the printed response shape.
//
// In a hosted deployment this body would live inside an HTTP handler
// reading the POST body, calling `_verify_password`, then returning
// `_login_response`. Mighty's host bridge for `std.http.serve` is the
// other forcing-function demo (demo 01); demo 12 keeps the focus on
// the v0.39 + v0.40 crypto/UUID/URL surfaces.
// ---------------------------------------------------------------------
fn main() {
  log("evt:auth:start")

  // Setup — values that in production would come from KMS + the
  // request body. The pepper and master_key are *server-side secrets*;
  // the username/password are user-supplied.
  let pepper = "server-pepper-from-kms"
  let master_key = "server-master-from-kms"
  let username = "ihassard"
  let password = "correct horse battery staple"

  // 1) Provision step (would happen at signup). The hash is what we
  //    store in the user table.
  let stored_hash = _hash_password(pepper, password)
  log("evt:auth:hashed")

  // 2) Login step — verify the candidate password against the stored
  //    HMAC tag.
  let ok = _verify_password(pepper, password, stored_hash)
  if !ok {
    log("evt:auth:reject")
    return
  }
  log("evt:auth:verified")

  // 3) Generate a session id (UUIDv7 — time-ordered).
  let session_id = _new_session_id()
  log("evt:auth:session-id")

  // 4) Derive a per-session AEAD key + fresh nonce.
  let session_key = _derive_session_key(master_key, session_id)
  let nonce = _fresh_nonce()
  log("evt:auth:keyed")

  // 5) Seal the session payload with AES-GCM. The version tag is the
  //    AAD so a future key rotation rejects stale cookies.
  let payload = "uid=" + username + ";scope=read,write;exp=+3600s"
  let sealed = _seal_cookie(session_key, nonce, "v=1", payload)
  log("evt:auth:sealed")

  // 6) Build the Set-Cookie header and the response body. Both
  //    helpers are surface-pinned by the smoke script via static text
  //    grep; we log only stable markers here because the runtime
  //    `log` path for AEAD-derived dynamic strings is still v0.41 work
  //    (tracked alongside the demo's smoke pipeline).
  let _header = _set_cookie_header("sid", sealed)
  let _response = _login_response(session_id, _header)
  log("evt:auth:cookie")

  // 7) On a subsequent request the server would extract the cookie,
  //    base64-decode + decrypt to recover the original payload. The
  //    AAD must match exactly or decryption fails.
  let _recovered = _open_cookie(session_key, nonce, "v=1", sealed)
  log("evt:auth:roundtrip-ok")
  log("web_auth: login pipeline OK (v0.39 + v0.40)")
}
