// selfhost/lexer/lib.sd
//
// Package root for the self-hosted Stardust lexer.
//
// The actual implementation is consolidated in `lexer.sd` for v0.4
// (single-file compilation) — the `lib.sd` / `syntax_kind.sd` / `lexer.sd`
// split documents the intended v0.5+ module structure once `sdust-pkg`
// supports cross-file `use selfhost_lexer.SyntaxKind` resolution.
//
// See `selfhost/README.md` for the roadmap and
// `docs/internals/self-hosting.md` for the bootstrap technique.

package selfhost_lexer

// In v0.5, this file will host the public re-exports of the package:
//
//   pub use syntax_kind.SyntaxKind
//   pub use syntax_kind.kind_name
//   pub use syntax_kind.ident_to_kind
//   pub use lexer.lex
//
// For v0.4 the v0.3 driver only compiles a single file at a time, so
// every consumer goes through `lexer.sd` directly. This file exists so
// the package directory has a conventional entry-point name; `sdust
// check selfhost/lexer/lib.sd` validates that the package decl parses
// and the prelude resolves.

fn _lib_marker() -> Str { "selfhost_lexer v0.4" }
