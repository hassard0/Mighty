// v0.3 (A40 closure): Block-policy backpressure. A sender that
// exceeds the mailbox capacity waits until the handler drains.
// Under Block policy, the system never drops or fails on overflow.
//
// In the SIR-interp-driven harness the sends are synchronous so no
// real backpressure is observable; the case shape is preserved so
// the spec-to-test mapping is explicit and the runtime-level
// invariant is in `crates/mty-runtime/tests/mailbox_slab_pool.rs
// ::block_policy_backpressures_until_drained`.

protocol P {
  Push(n: I32) -> I32
}

agent Pusher: P {
  on Push(n) -> n + 1
}

fn main() {
  let h = spawn Pusher()
  // v0.29 Track C: the typed `?Msg(args)` ask now resolves to the
  // protocol's declared `-> I32` reply at the call site (pre-v0.29
  // this was a fresh inference var, so `log(a)` slid through unify).
  // We render the I32 reply to Str explicitly so `log` sees its
  // declared Str argument.
  let a = h?Push(0)
  let b = h?Push(1)
  let c = h?Push(2)
  log(a.to_str())
  log(b.to_str())
  log(c.to_str())
}
