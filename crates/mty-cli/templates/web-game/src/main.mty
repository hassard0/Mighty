// {{NAME}} — a Mighty web-game starting point.
//
// Generated by `mty new --template web-game {{NAME}}`. Built with
// `mty build --target wasm32-web` and served with `mty serve`.
//
// ## Architecture
//
// The Mighty agent below owns the *game state* (score, alive flag,
// per-input handlers). The JS host in `web/dom-shim.js`:
//
//   1. fetches `/main.wasm`,
//   2. extracts the core wasm module from the Component Model
//      envelope (browsers don't execute components natively yet —
//      same trick as `demos/05_notetris_web/web/dom-shim.js`),
//   3. instantiates with a `log` import that this guest uses as a
//      v0.22-era state-event channel, and
//   4. wires keyboard events to the exported `move_*` / `fire` /
//      `tick` / `reset` functions below.
//
// ## NOTE — canvas WIT lands in v0.24
//
// In v0.23 the guest cannot yet draw to the canvas directly. The
// browser-side `mty:web/canvas@0.1` host shim is being landed by
// Track A in parallel with this slice, so `mty new --template
// web-game` deliberately ships the v0.22 `log("evt:...")` pattern
// — the same one `demos/05_notetris_web/src/main.mty` uses. When
// the canvas binding lands, regenerate or hand-patch the agent
// to call `std.web.Canvas.{clear, fill_rect, request_animation_frame}`
// directly and drop the JS-side game mirror.
//
// See `crates/mty-codegen-wasm/wit/mty-web/canvas.wit` for the
// shape the v0.24 port will target.
package {{NAME}}

// ----------------------------------------------------------------
// Protocol — every keystroke maps to one of these messages. Add new
// variants here as the game grows; remember to add a matching
// `export fn` below for the JS host to call into.
// ----------------------------------------------------------------

protocol GameInput {
  Left()    -> Unit
  Right()   -> Unit
  Up()      -> Unit
  Down()    -> Unit
  Fire()    -> Unit
  Tick()    -> Unit
  Reset()   -> Unit
}

// ----------------------------------------------------------------
// Game agent — single source of truth for game state. Until the
// canvas WIT lands (see NOTE above), each handler `log("evt:...")`s
// a line the JS shim parses into a draw call.
// ----------------------------------------------------------------

agent Game: GameInput {
  alive = true
  score = 0

  on Left() {
    log("evt:move:left")
  }

  on Right() {
    log("evt:move:right")
  }

  on Up() {
    log("evt:move:up")
  }

  on Down() {
    log("evt:move:down")
  }

  on Fire() {
    log("evt:fire")
  }

  on Tick() {
    log("evt:tick")
  }

  on Reset() {
    log("evt:reset")
    score = 0
    alive = true
  }
}

// ----------------------------------------------------------------
// Exported entry points the JS host calls on each keystroke or
// animation frame. The v0.24 canvas-WIT version will collapse most
// of these into the agent's own animation-frame loop driven by
// `std.web.Canvas.request_animation_frame()`.
// ----------------------------------------------------------------

export fn start() {
  log("evt:start")
}

export fn move_left() {
  log("evt:move:left")
}

export fn move_right() {
  log("evt:move:right")
}

export fn move_up() {
  log("evt:move:up")
}

export fn move_down() {
  log("evt:move:down")
}

export fn fire() {
  log("evt:fire")
}

export fn tick() {
  log("evt:tick")
}

export fn reset() {
  log("evt:reset")
}

fn main() {
  log("{{NAME}}: built")
}
