{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Mighty",
  "scopeName": "source.mty",
  "fileTypes": ["mty"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.mighty",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.mighty",
          "match": "//.*$"
        },
        {
          "name": "comment.block.mighty",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.html.mighty",
          "begin": "html\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mighty",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.mighty",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.mighty",
              "match": "\\\\(x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\}|[nrt0\\\\\"'])"
            }
          ]
        },
        {
          "name": "string.quoted.single.mighty",
          "match": "'([^'\\\\]|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.duration.mighty",
          "match": "\\b[0-9_]+(ns|us|ms|s|m|h)\\b"
        },
        {
          "name": "constant.numeric.size.mighty",
          "match": "\\b[0-9_]+(KiB|MiB|GiB|B|k|M)\\b"
        },
        {
          "name": "constant.numeric.float.mighty",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.mighty",
          "match": "\\b[0-9][0-9_]*([iuf](8|16|32|64|128))?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.mighty",
          "match": "\\b(if|else|match|for|while|loop|return|in|yield|await|break|continue)\\b"
        },
        {
          "name": "keyword.declaration.mighty",
          "match": "\\b(fn|struct|enum|type|trait|impl|agent|protocol|supervisor|sup|macro|const|mod|use|import|package|extern|export|sandbox|state|on|child|on_fail|restart|backoff|up_to)\\b"
        },
        {
          "name": "keyword.modifier.mighty",
          "match": "\\b(pub|mut|ref|move|unsafe|async|spawn|task|detach|join|scope|run|arena|budget|with|where|requires|derive|dyn|self|cap|effect|as)\\b"
        },
        {
          "name": "storage.type.mighty",
          "match": "\\b(let)\\b"
        },
        {
          "name": "constant.language.bool.mighty",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.mighty",
          "match": "\\b(Bool|Char|Str|String|Bytes|Unit|Never|Duration|Size|I8|I16|I32|I64|I128|U8|U16|U32|U64|U128|ISize|USize|F32|F64|Result|Option)\\b"
        },
        {
          "name": "entity.name.type.mighty",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.mighty",
          "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.mighty" },
            "2": { "name": "entity.name.function.mighty" }
          }
        },
        {
          "name": "meta.function-call.mighty",
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*\\(",
          "captures": {
            "1": { "name": "entity.name.function.mighty" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.mighty",
          "match": "(=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=)"
        },
        {
          "name": "keyword.operator.comparison.mighty",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.mighty",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.mighty",
          "match": "(\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.range.mighty",
          "match": "(\\.\\.=|\\.\\.)"
        },
        {
          "name": "keyword.operator.message.mighty",
          "match": "(!|\\?)"
        },
        {
          "name": "keyword.operator.borrow.mighty",
          "match": "(&mut|&)"
        }
      ]
    }
  }
}
