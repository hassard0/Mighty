// demo 08_swarm_review — v0.27 forcing-function demo for std.swarm.
//
// One Mighty program consumes every v0.27 track end-to-end:
//
//   * Track A — source-level `@tool("desc", cap: fs.read)` decorator
//     on `read_snippet`. The decorator parses + lowers + macro-expands
//     into the synthesised `__tool_descriptor_read_snippet` /
//     `__tool_invoke_read_snippet` / `__tool_register_read_snippet`
//     companion fns. See `dev/history/notes/TOOL_ATTR_PARSER_V0_27_NOTES.md`.
//
//   * Track B — opaque-ADT handler-scope carve-out. The CodeReviewer
//     agent's `on Review` handler constructs `Working.new()` inline;
//     v0.26 would have hit MT2021 because `Working` wasn't a prelude
//     opaque ADT. See `dev/history/notes/OPAQUE_ADT_WASM_V0_27_NOTES.md`.
//     v0.29 Track B extends the same carve-out to the swarm ADTs
//     (`Member` / `DollarBudget` / `ConsensusStrategy` / `Consensus`)
//     so the agent also builds its own panel + budget + strategy
//     inside the handler — no more ctor-arg threading.
//
//   * Track C — full OpenAI / Gemini / Bedrock provider implementations.
//     The panel mixes Anthropic + OpenAI + Gemini so the swarm exercises
//     all three Track C providers in one call. See
//     `dev/history/notes/LLM_PROVIDERS_FULL_V0_27_NOTES.md`.
//
//   * Track D — `std.swarm` consensus primitive. `run_panel_review`
//     calls `swarm(prompt, panel, spend_cap, strategy)` to dispatch one
//     prompt to every panel member in parallel, then resolves the
//     replies through `ConsensusStrategy.Majority` into a `Consensus`.
//     See `dev/history/notes/STD_SWARM_V0_27_NOTES.md`.
//
//   * Track E — `std.env.args()` reads the `--`-tail positional argv,
//     so the demo accepts the code snippet on the command line:
//     `mty run demos/08_swarm_review/src/main.mty -- "<snippet>"`.
//     See `dev/history/notes/QOL_GAPS_V0_27_NOTES.md`.
//
// Build:
//   mty check demos/08_swarm_review/src/main.mty
//   ANTHROPIC_API_KEY=... OPENAI_API_KEY=... GEMINI_API_KEY=... \
//     mty run demos/08_swarm_review/src/main.mty -- "<code>"
//
// The smoke test in `smoke.sh` exercises the parse/check/fmt path; the
// opt-in `MTY_AGENT_SMOKE=1` stage spins up the three-route mock LLM
// server on a single port and asserts the swarm round-trips.
package swarm_review

use std.llm
use std.swarm
use std.memory
use std.fs
use std.env

// ---------------------------------------------------------------------
// Track A — source-level `@tool(...)` decorator on a user fn.
//
// `read_snippet(path)` is the tool the agent (or any MCP client) can
// invoke to pull a code snippet from the bundled corpus. For v0.27 the
// macro pass synthesises `__tool_descriptor_read_snippet` /
// `__tool_invoke_read_snippet` / `__tool_register_read_snippet`
// companion fns next to it; the descriptor is what an MCP-enabled LLM
// surfaces as a callable tool.
//
// `cap: fs.read` narrows the runtime capability — the v0.27 macro
// preserves the cap text in the descriptor JSON; the real cap-check
// fires inside `mty_stdlib::mcp::register_tool` once the v0.28
// `std.mcp` auto-prelude lands and lets us re-emit the runtime check
// from the synth body.
// ---------------------------------------------------------------------

@tool("Read a code snippet from the sample-snippets corpus", cap: fs.read)
fn read_snippet(path: Str) -> Str {
  // The interpreter dispatches `std.fs.read_to_string` through the
  // host extern table (returns Unit on the SIR path; real I/O fires
  // on the host-target build). The signature is the source-of-truth
  // for the `@tool` macro's descriptor synth.
  let _ignored = std.fs.read_to_string(path)
  path
}

// ---------------------------------------------------------------------
// Review protocol — the one message the CodeReviewer agent answers.
//
// Reply shape is the rendered consensus body (verdict + cost + dissent
// list) so `main()` can `log()` it directly without unpacking a struct
// (the v0.27 emitter doesn't yet lower user-defined struct returns
// out of handler scope; covered by example 28's pattern).
// ---------------------------------------------------------------------

protocol ReviewerInput {
  Review(snippet: Str) -> Str
}

// ---------------------------------------------------------------------
// Track D — the CodeReviewer agent. Builds the panel, budget, and
// strategy INSIDE the handler, delegates to `swarm(...)`, renders the
// consensus body, and returns it.
//
// v0.29 Track B carve-out: `Member.anthropic(...)`,
// `DollarBudget.from_dollars(...)`, and `ConsensusStrategy.Majority`
// are constructed directly inside `on Review(...)`. Pre-v0.29 the four
// swarm ADTs (`Member` / `DollarBudget` / `ConsensusStrategy` /
// `Consensus`) weren't in the v0.27 handler-safe set, so this demo
// had to lift the whole panel + budget + strategy build out into a
// `build_panel()`-style top-level helper threaded through ctor args.
// v0.29 Track B adds them to `crate::prelude::handler_safe_opaque_names`
// and this demo deletes the workaround.
//
// `Working.new()` (v0.27 Track B carve-out) still gets constructed in
// the same handler as a scratchpad for the per-review state.
// ---------------------------------------------------------------------
agent CodeReviewer: ReviewerInput {
  on Review(snippet) {
    // v0.27 Track B carve-out: per-review scratchpad.
    let working = Working.new()
    working.push("snippet", snippet)
    working.push("strategy", "majority")

    log("evt:reviewer:review")

    // v0.29 Track B carve-out: three-provider panel constructed
    // INSIDE the handler. Each Member ctor reads the canonical env
    // var (ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY); the
    // Rust-side `Member::<provider>` panics on a missing key —
    // swarms are an explicit choice and the silent fallback would
    // be worse than the loud panic.
    let panel = Vec.new()
    panel.push(Member.anthropic("claude-opus-4-7"))
    panel.push(Member.openai("gpt-5"))
    panel.push(Member.gemini("gemini-2.5-pro"))

    // v0.29 Track B carve-out: 50-cent shared spending cap across
    // the whole panel. `DollarBudget` resolves to the Rust-side
    // `SharedDollarBudget`; `from_dollars(0.50)` rounds to 50 cents
    // under the hood. Named `spend_cap` rather than `budget` because
    // `budget` is a reserved keyword in the v0.3 grammar (used by
    // the cap-narrow `with budget(...)` clause).
    let spend_cap = DollarBudget.from_dollars(0.50)

    let prompt = format!(
      "You are a careful security reviewer. Code:\n\n{}\n\nIs this code safe? Reply with: SAFE, UNSAFE, or UNCLEAR. Then one paragraph of reasoning.",
      snippet
    )

    // Track D entry point. `swarm(...)` dispatches `prompt` to every
    // panel member in parallel via `tokio::spawn`, charges each call
    // against the shared `spend_cap`, and resolves the replies
    // through `ConsensusStrategy.Majority` into a `Consensus`
    // result.
    //
    // The SIR interpreter dispatches `swarm` as a permissive extern
    // call — it returns `Value::Unit` on `mty run`. The real wiring
    // fires when `mty build --target host` lowers the call through
    // to `mty_stdlib::swarm::swarm`.
    let consensus = swarm(
      prompt,
      panel,
      spend_cap,
      ConsensusStrategy.Majority,
    )

    // Render the consensus — verdict + cost line + every dissent.
    // `consensus.majority` is `Option[Str]` on the typed surface;
    // the SIR path returns `Unit` so the unwrap_or fallback keeps
    // the body non-empty for the smoke test.
    let verdict = consensus.majority.unwrap_or("(no verdict)")
    let cost_cents = consensus.total_cost_cents
    let dissents = consensus.dissents

    let mut out = String.new()
    out.push_str(format!("verdict: {}\n", verdict))
    out.push_str(format!("cost cents: {}\n", cost_cents))
    out.push_str(format!("dissents: {}\n", dissents.len()))

    // Walk the dissent list. The SIR path returns `Value::Unit` for
    // `consensus.dissents` which the iter-protocol path materialises
    // as an empty array — so the loop is a no-op on `mty run` but
    // pins the call-site shape for the lowered host-target build.
    for d in dissents {
      out.push_str(format!("  - dissent: {}\n", d))
    }
    out
  }
}

// ---------------------------------------------------------------------
// `main` — boot the demo. Spawns one CodeReviewer (zero ctor args
// now — the panel + budget live inside the handler per v0.29 Track B),
// reads the snippet from the `--`-tail positional argv, asks the
// reviewer, logs the rendered consensus.
//
// Track E (QoL #3) — `std.env.args()` returns the `--`-tail positional
// argv. The leading positional lands at index 0; with no positional we
// fall back to a tiny `eval(user_input)` stand-in that any reviewer
// should flag UNSAFE.
// ---------------------------------------------------------------------
fn main() {
  // Spawn the reviewer with zero ctor args. v0.29 Track B carve-out
  // means the agent builds its own panel + budget inside the handler;
  // pre-v0.29 we had to thread `panel` + `spend_cap` through
  // `spawn CodeReviewer(panel, spend_cap)`.
  let reviewer = spawn CodeReviewer()

  // Track E: pick up the snippet from the `--`-tail positional argv.
  // No argv → use the canonical eval(user_input) stand-in so reviewers
  // have something to flag.
  let argv = std.env.args()
  let snippet = argv.get(0).unwrap_or("eval(user_input)  // canonical demo stand-in")

  let report = reviewer!Review(snippet)
  log("swarm_review: report follows")
  // `report` types as `Str` at the protocol surface but the v0.27 SIR
  // interpreter resolves the bang-send as `Unit` (the per-handler
  // return-shape lowering is a v0.28 follow-up). Wrap in `format!` so
  // `log(...)` sees a concrete `Str` and the file type-checks.
  log(format!("{}", report))
}
