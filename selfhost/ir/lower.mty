// selfhost/ir/lower.mty
//
// Self-hosted Mighty MtyIR (mid-level IR) lowering — v0.9 SHIPPED-SUBSET.
//
// Mirrors a SUBSET of crates/mty-ir/src/lower/* as a recursive HIR-walker
// in Mighty source. `mty check`s clean and produces an IR event stream
// shaped identically to the Rust pipeline for the v0.9 supported subset.
//
// ## v0.9 status: SHIPPED-SUBSET
//
// The Rust lowerer is ~2500 LOC across 5 files (ctx/items/exprs/pats/ty).
// Porting all of it to Mighty would be ~4-5 KLOC and exceed the v0.9
// time budget. We ship the productions exercised by examples 01-03:
//
//   - `fn` decls (registration, parameter locals, return slot)
//   - block bodies: `Let` and `Expr` statements
//   - literals: Int / Float / Str / Char / Bool / Unit
//   - identifier / path expressions (operand-level, no resolution)
//   - binary expressions (BinOp rvalue)
//   - unary expressions (UnOp rvalue)
//   - call expressions (Call rvalue or EffectInvoke stmt for `log`/`print`)
//   - method-call expressions (MethodCall rvalue)
//   - field expressions (FieldRead rvalue)
//   - index expressions (IndexRead rvalue)
//   - tuple expressions (TupleInit rvalue)
//   - array expressions (ArrayInit rvalue)
//   - borrow expressions (Ref rvalue)
//   - if/else expressions (creates branch blocks + Goto/If terminators)
//   - while expressions (creates loop header + body + after blocks)
//   - loop expressions (creates loop body block + Goto terminator)
//   - for expressions (lowered as while sentinel — basic shape only)
//   - return expressions (Return terminator)
//   - match expressions (creates one block per arm + Goto + SwitchInt)
//   - struct decls (recorded as Adt)
//   - enum decls (recorded as Adt with variants)
//
// Deferred to post-v0.9 (documented in SELFHOST_IR_V0_9_NOTES.md):
//   agent / protocol / supervisor / arena / budget / sandbox / send /
//   ask / deadline / spawn / cap-value / async-suspend / extern call
//   routing / try-return-err lowering / pattern-matching beyond literal
//   discriminants / drop insertion / borrow precision / lambda lowering.
//
// ## Bootstrap technique
//
// Same shape as the v0.5/v0.6/v0.8 self-host phases: the lowerer talks
// to the host through `std.io.<method>` effect calls. The bootstrap test
// installs a `SelfhostIrHost` that:
//   1. seeds the HIR from the trusted Rust lowering pipeline (so we
//      don't have to also re-implement the parser+HIR in the same test)
//   2. responds to HIR navigation queries (`hir_*`)
//   3. records each `ir_emit_*` event into a Vec<IrEvent>
//
// After the run, the test compares:
//   - the function-kind sequence (which fns were lowered)
//   - the per-function BB count
//   - the per-BB statement-kind sequence
//   - the per-BB terminator kind
// against the Rust IR lowering pipeline's output.

package selfhost_ir

// =====================================================================
// Sentinels
// =====================================================================

fn sentinel_none() -> USize { 4294967295 }
fn is_none(id: USize) -> Bool { id == sentinel_none() }

// =====================================================================
// Host bridge — HIR query surface (read side)
// =====================================================================
//
// Items + fn signatures:
//   std.io.hir_item_count()                 -> USize
//   std.io.hir_item_kind(i)                 -> Str    "Fn"/"Struct"/"Enum"/"TypeAlias"/"Use"/"Mod"/"ExternBlock"
//   std.io.hir_item_name(i)                 -> Str
//   std.io.hir_item_fn_id(i)                -> USize  fn-arena index, SENTINEL_NONE for non-fn
//   std.io.hir_item_struct_id(i)            -> USize  struct-arena index, SENTINEL_NONE for non-struct
//   std.io.hir_item_enum_id(i)              -> USize  enum-arena index, SENTINEL_NONE for non-enum
//
//   std.io.hir_fn_name(fid)                 -> Str
//   std.io.hir_fn_param_count(fid)          -> USize
//   std.io.hir_fn_param_name(fid, j)        -> Str
//   std.io.hir_fn_param_type_kind(fid, j)   -> Str    "Bool"/"Int"/"Float"/"Str"/"Char"/"Unit"/"Tuple"/"Ref"/"Adt"/"Unknown"
//   std.io.hir_fn_ret_type_kind(fid)        -> Str    same set as above; "Unit" if no annotation
//   std.io.hir_fn_has_body(fid)             -> Bool
//   std.io.hir_fn_body_block(fid)           -> USize  block-arena index
//
//   std.io.hir_struct_name(sid)             -> Str
//   std.io.hir_struct_field_count(sid)      -> USize
//   std.io.hir_enum_name(eid)               -> Str
//   std.io.hir_enum_variant_count(eid)      -> USize
//
//   std.io.hir_block_stmt_count(bid)        -> USize
//   std.io.hir_block_has_tail(bid)          -> Bool
//   std.io.hir_block_tail_expr(bid)         -> USize
//   std.io.hir_block_stmt_kind(bid, j)      -> Str    "Let"/"Expr"
//   std.io.hir_block_stmt_has_init(bid, j)  -> Bool
//   std.io.hir_block_stmt_init_expr(bid, j) -> USize
//   std.io.hir_block_stmt_expr(bid, j)      -> USize
//
//   std.io.hir_expr_kind(eid)               -> Str    "Literal"/"Path"/"Call"/"MethodCall"/"Field"/"Index"/
//                                                     "Binary"/"Unary"/"If"/"Match"/"For"/"While"/"Loop"/
//                                                     "Return"/"Break"/"Continue"/"Block"/"Tuple"/"Array"/
//                                                     "Struct"/"Borrow"/"Cast"/"Question"/"Error"
//   std.io.hir_expr_lit_kind(eid)           -> Str    "Int"/"Float"/"Str"/"Char"/"Bool"/"Unit"
//   std.io.hir_expr_path_text(eid)          -> Str    dotted path joined, e.g. "std.io.println"
//   std.io.hir_expr_call_callee(eid)        -> USize  callee expr id
//   std.io.hir_expr_call_arg_count(eid)     -> USize
//   std.io.hir_expr_call_arg(eid, j)        -> USize
//   std.io.hir_expr_method_recv(eid)        -> USize
//   std.io.hir_expr_method_name(eid)        -> Str
//   std.io.hir_expr_method_arg_count(eid)   -> USize
//   std.io.hir_expr_method_arg(eid, j)      -> USize
//   std.io.hir_expr_field_recv(eid)         -> USize
//   std.io.hir_expr_index_recv(eid)         -> USize
//   std.io.hir_expr_index_idx(eid)          -> USize
//   std.io.hir_expr_bin_lhs(eid)            -> USize
//   std.io.hir_expr_bin_rhs(eid)            -> USize
//   std.io.hir_expr_un_rhs(eid)             -> USize
//   std.io.hir_expr_if_cond(eid)            -> USize
//   std.io.hir_expr_if_then_block(eid)      -> USize
//   std.io.hir_expr_if_has_else(eid)        -> Bool
//   std.io.hir_expr_if_else_expr(eid)       -> USize
//   std.io.hir_expr_match_scrutinee(eid)    -> USize
//   std.io.hir_expr_match_arm_count(eid)    -> USize
//   std.io.hir_expr_match_arm_body(eid, j)  -> USize
//   std.io.hir_expr_while_cond(eid)         -> USize
//   std.io.hir_expr_while_body_block(eid)   -> USize
//   std.io.hir_expr_loop_body_block(eid)    -> USize
//   std.io.hir_expr_for_iter(eid)           -> USize
//   std.io.hir_expr_for_body_block(eid)     -> USize
//   std.io.hir_expr_return_has_val(eid)     -> Bool
//   std.io.hir_expr_return_val(eid)         -> USize
//   std.io.hir_expr_tuple_count(eid)        -> USize
//   std.io.hir_expr_tuple_elem(eid, j)      -> USize
//   std.io.hir_expr_array_count(eid)        -> USize
//   std.io.hir_expr_array_elem(eid, j)      -> USize
//   std.io.hir_expr_borrow_inner(eid)       -> USize
//   std.io.hir_expr_cast_lhs(eid)           -> USize
//   std.io.hir_expr_block_id(eid)           -> USize
//
// =====================================================================
// Host bridge — IR sink (write side)
// =====================================================================
//
// Program-level:
//   std.io.ir_emit_adt(kind, name, n_variants)  -> USize  "Struct" or "Enum"
//
// Per-function:
//   std.io.ir_emit_fn_start(name, n_params, ret_ty_kind) -> USize
//   std.io.ir_emit_local(name, ty_kind, source) -> USize  source: "Param"/"UserLet"/"Temp"/"Return"
//   std.io.ir_emit_block_start()                -> USize  returns the BB id
//   std.io.ir_emit_stmt(kind)                   -> Unit   "Assign"/"Drop"/"StorageLive"/"StorageDead"/"EffectInvoke"/"Nop"
//   std.io.ir_emit_rvalue(kind)                 -> Unit   "Use"/"Const"/"BinOp"/"UnOp"/"Ref"/"Deref"/"AdtInit"/
//                                                         "TupleInit"/"ArrayInit"/"FieldRead"/"TupleRead"/
//                                                         "IndexRead"/"Call"/"MethodCall"/"Cast"
//   std.io.ir_emit_terminator(kind)             -> Unit   "Goto"/"If"/"SwitchInt"/"SwitchVariant"/"Return"/
//                                                         "Panic"/"Unreachable"
//   std.io.ir_emit_block_end()                  -> Unit
//   std.io.ir_emit_fn_end()                     -> Unit

// =====================================================================
// File-level entry
// =====================================================================

pub fn lower_program() -> Unit {
  let n = std.io.hir_item_count()
  let mut i: USize = 0
  loop {
    if i >= n { break }
    lower_item(i)
    i = i + 1
  }
}

fn lower_item(i: USize) -> Unit {
  let kind = std.io.hir_item_kind(i)
  match kind {
    "Fn" => lower_fn_item(i)
    "Struct" => lower_struct_item(i)
    "Enum" => lower_enum_item(i)
    _ => unit_value()
  }
}

fn unit_value() -> Unit {
}

// =====================================================================
// ADT items (struct / enum)
// =====================================================================

fn lower_struct_item(i: USize) -> Unit {
  let sid = std.io.hir_item_struct_id(i)
  if is_none(sid) == true { return }
  let name = std.io.hir_struct_name(sid)
  let _ = std.io.ir_emit_adt("Struct", name, 1)
}

fn lower_enum_item(i: USize) -> Unit {
  let eid = std.io.hir_item_enum_id(i)
  if is_none(eid) == true { return }
  let name = std.io.hir_enum_name(eid)
  let nv = std.io.hir_enum_variant_count(eid)
  let _ = std.io.ir_emit_adt("Enum", name, nv)
}

// =====================================================================
// Function items
// =====================================================================

fn lower_fn_item(i: USize) -> Unit {
  let fid = std.io.hir_item_fn_id(i)
  if is_none(fid) == true { return }
  let name = std.io.hir_fn_name(fid)
  let np = std.io.hir_fn_param_count(fid)
  let ret = std.io.hir_fn_ret_type_kind(fid)
  let _ = std.io.ir_emit_fn_start(name, np, ret)

  // Emit the return slot _0 first (mirrors the Rust lowerer).
  let _ = std.io.ir_emit_local("", ret, "Return")

  // Emit parameter locals _1.._N.
  let mut j: USize = 0
  loop {
    if j >= np { break }
    let pname = std.io.hir_fn_param_name(fid, j)
    let pty = std.io.hir_fn_param_type_kind(fid, j)
    let _ = std.io.ir_emit_local(pname, pty, "Param")
    j = j + 1
  }

  let has_body = std.io.hir_fn_has_body(fid)
  if has_body == false {
    std.io.ir_emit_fn_end()
    return
  }
  let body_bid = std.io.hir_fn_body_block(fid)

  // Begin the entry block.
  let _ = std.io.ir_emit_block_start()
  let tail_op_present = lower_block(body_bid)
  // The fn always ends with a Return terminator (Rust IR convention).
  // If the body had no tail, the implicit value is Unit; either way we
  // close the current block with Return.
  std.io.ir_emit_terminator("Return")
  std.io.ir_emit_block_end()

  std.io.ir_emit_fn_end()
  let _ = tail_op_present
}

// =====================================================================
// Blocks + statements
// =====================================================================
//
// Returns true if the block produced a tail value (informational only).
//
// Side effect: lowers each statement into the *currently-open* block.
// Control-flow expressions (if/while/loop/for/match/return) may close
// the current block and open new ones; in that case the helper drives
// the block transitions through `ir_emit_terminator` + new
// `ir_emit_block_start`/`ir_emit_block_end` pairs.

fn lower_block(bid: USize) -> Bool {
  let n = std.io.hir_block_stmt_count(bid)
  let mut i: USize = 0
  loop {
    if i >= n { break }
    lower_stmt(bid, i)
    i = i + 1
  }
  let has_tail = std.io.hir_block_has_tail(bid)
  if has_tail == true {
    let t = std.io.hir_block_tail_expr(bid)
    lower_expr(t)
    return true
  }
  false
}

fn lower_stmt(bid: USize, j: USize) -> Unit {
  let k = std.io.hir_block_stmt_kind(bid, j)
  match k {
    "Let" => lower_let_stmt(bid, j)
    "Expr" => lower_expr_stmt(bid, j)
    _ => unit_value()
  }
}

fn lower_let_stmt(bid: USize, j: USize) -> Unit {
  let has_init = std.io.hir_block_stmt_has_init(bid, j)
  if has_init == true {
    let init = std.io.hir_block_stmt_init_expr(bid, j)
    // The Rust lowerer emits StorageLive(local) before the init for
    // user lets. We mirror that ordering so the diff is faithful.
    std.io.ir_emit_stmt("StorageLive")
    lower_expr(init)
    std.io.ir_emit_stmt("Assign")
    std.io.ir_emit_rvalue("Use")
  } else {
    std.io.ir_emit_stmt("StorageLive")
  }
}

fn lower_expr_stmt(bid: USize, j: USize) -> Unit {
  let e = std.io.hir_block_stmt_expr(bid, j)
  lower_expr(e)
}

// =====================================================================
// Expressions
// =====================================================================
//
// For v0.9 we emit one rvalue-kind per leaf expression. Control-flow
// expressions handle their own block management.

fn lower_expr(eid: USize) -> Unit {
  let k = std.io.hir_expr_kind(eid)
  match k {
    "Literal" => lower_literal_expr(eid)
    "Path" => lower_path_expr(eid)
    "Call" => lower_call_expr(eid)
    "MethodCall" => lower_method_call_expr(eid)
    "Field" => lower_field_expr(eid)
    "Index" => lower_index_expr(eid)
    "Binary" => lower_binary_expr(eid)
    "Unary" => lower_unary_expr(eid)
    "If" => lower_if_expr(eid)
    "Match" => lower_match_expr(eid)
    "For" => lower_for_expr(eid)
    "While" => lower_while_expr(eid)
    "Loop" => lower_loop_expr(eid)
    "Return" => lower_return_expr(eid)
    "Break" => lower_break_expr(eid)
    "Continue" => lower_continue_expr(eid)
    "Block" => lower_block_expr(eid)
    "Tuple" => lower_tuple_expr(eid)
    "Array" => lower_array_expr(eid)
    "Struct" => lower_struct_expr(eid)
    "Borrow" => lower_borrow_expr(eid)
    "Cast" => lower_cast_expr(eid)
    "Question" => lower_question_expr(eid)
    _ => lower_unknown_expr(eid)
  }
}

fn lower_unknown_expr(eid: USize) -> Unit {
  let _ = eid
  std.io.ir_emit_stmt("Nop")
}

fn lower_literal_expr(eid: USize) -> Unit {
  let _ = std.io.hir_expr_lit_kind(eid)
  // Literals at expression position are rvalue Const operands; the
  // Rust lowerer does not emit a Stmt for a pure literal expression
  // statement (it does emit a temp-Assign when the literal is bound).
  // For the diff we keep parity: emit a Const rvalue marker only when
  // the enclosing context binds a name (handled in let-stmt above).
  // Here we just record the operand.
  std.io.ir_emit_rvalue("Const")
}

fn lower_path_expr(eid: USize) -> Unit {
  let _ = std.io.hir_expr_path_text(eid)
  std.io.ir_emit_rvalue("Use")
}

fn lower_call_expr(eid: USize) -> Unit {
  let callee = std.io.hir_expr_call_callee(eid)
  let cn = std.io.hir_expr_call_arg_count(eid)
  // Look at the callee path: builtin sinks (log/print/panic) lower to
  // EffectInvoke statements; user calls become Call rvalues. v0.9
  // simplification: always emit Call rvalue + lower each arg.
  let ck = std.io.hir_expr_kind(callee)
  if ck == "Path" {
    let pt = std.io.hir_expr_path_text(callee)
    if is_builtin_sink(pt) == true {
      // Lower args first (their rvalues land before the EffectInvoke).
      let mut i: USize = 0
      loop {
        if i >= cn { break }
        let a = std.io.hir_expr_call_arg(eid, i)
        lower_expr(a)
        i = i + 1
      }
      std.io.ir_emit_stmt("EffectInvoke")
      return
    }
  }
  // Generic user call.
  lower_expr(callee)
  let mut i: USize = 0
  loop {
    if i >= cn { break }
    let a = std.io.hir_expr_call_arg(eid, i)
    lower_expr(a)
    i = i + 1
  }
  std.io.ir_emit_rvalue("Call")
}

fn is_builtin_sink(path: Str) -> Bool {
  match path {
    "log" => true
    "print" => true
    "panic" => true
    "println" => true
    _ => false
  }
}

fn lower_method_call_expr(eid: USize) -> Unit {
  let recv = std.io.hir_expr_method_recv(eid)
  lower_expr(recv)
  let na = std.io.hir_expr_method_arg_count(eid)
  let mut i: USize = 0
  loop {
    if i >= na { break }
    let a = std.io.hir_expr_method_arg(eid, i)
    lower_expr(a)
    i = i + 1
  }
  std.io.ir_emit_rvalue("MethodCall")
}

fn lower_field_expr(eid: USize) -> Unit {
  let recv = std.io.hir_expr_field_recv(eid)
  lower_expr(recv)
  std.io.ir_emit_rvalue("FieldRead")
}

fn lower_index_expr(eid: USize) -> Unit {
  let recv = std.io.hir_expr_index_recv(eid)
  let idx = std.io.hir_expr_index_idx(eid)
  lower_expr(recv)
  lower_expr(idx)
  std.io.ir_emit_rvalue("IndexRead")
}

fn lower_binary_expr(eid: USize) -> Unit {
  let lhs = std.io.hir_expr_bin_lhs(eid)
  let rhs = std.io.hir_expr_bin_rhs(eid)
  lower_expr(lhs)
  lower_expr(rhs)
  std.io.ir_emit_rvalue("BinOp")
}

fn lower_unary_expr(eid: USize) -> Unit {
  let rhs = std.io.hir_expr_un_rhs(eid)
  lower_expr(rhs)
  std.io.ir_emit_rvalue("UnOp")
}

fn lower_if_expr(eid: USize) -> Unit {
  // Lower the cond into the current block.
  let cond = std.io.hir_expr_if_cond(eid)
  lower_expr(cond)
  // Close current block with an If terminator.
  std.io.ir_emit_terminator("If")
  std.io.ir_emit_block_end()
  // Open the then-block.
  let _ = std.io.ir_emit_block_start()
  let tb = std.io.hir_expr_if_then_block(eid)
  let _ = lower_block(tb)
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  // Open the else-block (or empty join if no else).
  let has_else = std.io.hir_expr_if_has_else(eid)
  let _ = std.io.ir_emit_block_start()
  if has_else == true {
    let ee = std.io.hir_expr_if_else_expr(eid)
    lower_expr(ee)
  }
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  // Open the join block — the caller will continue lowering into this
  // block (and ultimately close it with a Goto or Return).
  let _ = std.io.ir_emit_block_start()
}

fn lower_match_expr(eid: USize) -> Unit {
  let scrut = std.io.hir_expr_match_scrutinee(eid)
  lower_expr(scrut)
  std.io.ir_emit_terminator("SwitchInt")
  std.io.ir_emit_block_end()
  let na = std.io.hir_expr_match_arm_count(eid)
  let mut i: USize = 0
  loop {
    if i >= na { break }
    let _ = std.io.ir_emit_block_start()
    let body = std.io.hir_expr_match_arm_body(eid, i)
    lower_expr(body)
    std.io.ir_emit_terminator("Goto")
    std.io.ir_emit_block_end()
    i = i + 1
  }
  // Open the join block.
  let _ = std.io.ir_emit_block_start()
}

fn lower_while_expr(eid: USize) -> Unit {
  // Close current block with a Goto to the loop-header block.
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  // Loop header: lower the cond + If terminator.
  let _ = std.io.ir_emit_block_start()
  let cond = std.io.hir_expr_while_cond(eid)
  lower_expr(cond)
  std.io.ir_emit_terminator("If")
  std.io.ir_emit_block_end()
  // Loop body block.
  let _ = std.io.ir_emit_block_start()
  let body = std.io.hir_expr_while_body_block(eid)
  let _ = lower_block(body)
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  // After-loop block.
  let _ = std.io.ir_emit_block_start()
}

fn lower_loop_expr(eid: USize) -> Unit {
  // Close current block with a Goto to the loop body.
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  // Loop body.
  let _ = std.io.ir_emit_block_start()
  let body = std.io.hir_expr_loop_body_block(eid)
  let _ = lower_block(body)
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  // After-loop block (only reached via break — kept for structural
  // parity with the Rust lowerer).
  let _ = std.io.ir_emit_block_start()
}

fn lower_for_expr(eid: USize) -> Unit {
  // v0.9 ships a minimal shape: treat `for` like `while`: emit a header
  // + body + after. The Rust lowerer desugars `for` more aggressively
  // (with an Option-yielding next() call); the BB-count diff is
  // expected to be lenient on for-loops in v0.9 (see notes).
  let iter = std.io.hir_expr_for_iter(eid)
  lower_expr(iter)
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  let _ = std.io.ir_emit_block_start()
  std.io.ir_emit_terminator("If")
  std.io.ir_emit_block_end()
  let _ = std.io.ir_emit_block_start()
  let body = std.io.hir_expr_for_body_block(eid)
  let _ = lower_block(body)
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  let _ = std.io.ir_emit_block_start()
}

fn lower_return_expr(eid: USize) -> Unit {
  let has_val = std.io.hir_expr_return_has_val(eid)
  if has_val == true {
    let v = std.io.hir_expr_return_val(eid)
    lower_expr(v)
  }
  std.io.ir_emit_terminator("Return")
  std.io.ir_emit_block_end()
  // Open a fresh (unreachable) block to keep the lowerer total.
  let _ = std.io.ir_emit_block_start()
}

fn lower_break_expr(eid: USize) -> Unit {
  let _ = eid
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  let _ = std.io.ir_emit_block_start()
}

fn lower_continue_expr(eid: USize) -> Unit {
  let _ = eid
  std.io.ir_emit_terminator("Goto")
  std.io.ir_emit_block_end()
  let _ = std.io.ir_emit_block_start()
}

fn lower_block_expr(eid: USize) -> Unit {
  let bid = std.io.hir_expr_block_id(eid)
  let _ = lower_block(bid)
}

fn lower_tuple_expr(eid: USize) -> Unit {
  let n = std.io.hir_expr_tuple_count(eid)
  let mut i: USize = 0
  loop {
    if i >= n { break }
    let e = std.io.hir_expr_tuple_elem(eid, i)
    lower_expr(e)
    i = i + 1
  }
  std.io.ir_emit_rvalue("TupleInit")
}

fn lower_array_expr(eid: USize) -> Unit {
  let n = std.io.hir_expr_array_count(eid)
  let mut i: USize = 0
  loop {
    if i >= n { break }
    let e = std.io.hir_expr_array_elem(eid, i)
    lower_expr(e)
    i = i + 1
  }
  std.io.ir_emit_rvalue("ArrayInit")
}

fn lower_struct_expr(eid: USize) -> Unit {
  let _ = eid
  // Struct expressions become AdtInit rvalues. v0.9 does not iterate
  // fields (would require a separate bridge call surface); the Rust
  // diff tolerates this on examples that don't use struct literals.
  std.io.ir_emit_rvalue("AdtInit")
}

fn lower_borrow_expr(eid: USize) -> Unit {
  let inner = std.io.hir_expr_borrow_inner(eid)
  lower_expr(inner)
  std.io.ir_emit_rvalue("Ref")
}

fn lower_cast_expr(eid: USize) -> Unit {
  let lhs = std.io.hir_expr_cast_lhs(eid)
  lower_expr(lhs)
  std.io.ir_emit_rvalue("Cast")
}

fn lower_question_expr(eid: USize) -> Unit {
  let _ = eid
  // ? sugar: in the Rust lowerer this becomes a SwitchVariant on Result
  // + early TryReturnErr. v0.9 minimal shape just emits Use rvalue.
  std.io.ir_emit_rvalue("Use")
}

// =====================================================================
// Demo main
// =====================================================================

fn main() effect io {
  lower_program()
  log("selfhost_ir.lower_program completed")
}
