<!--
  Mighty JetBrains IDE plugin manifest.

  The IntelliJ Platform Gradle Plugin 2.x rewrites <id>, <name>, <version>,
  <idea-version>, <vendor>, and <description> from gradle.properties +
  build.gradle.kts at build time, but we include sensible defaults so the
  manifest is readable in source control.

  v0.32: split into a base manifest + `mighty-lsp.xml` config-file. The LSP
  integration is now declared via `<depends optional="true"
  config-file="mighty-lsp.xml">com.intellij.modules.lsp</depends>`, which
  loads the LSP-only extensions on Ultimate/paid IDEs and silently skips
  them on Community editions. Community users still get TextMate-grammar
  highlighting, file-type registration, file templates, the CLI actions,
  the settings page, and the cost tool window.
-->
<idea-plugin>
    <id>dev.mighty.jetbrains</id>
    <name>Mighty</name>
    <version>0.32.0</version>
    <vendor email="ihassard@gmail.com" url="https://hassard0.github.io/Mighty/">Hassard</vendor>

    <description><![CDATA[
        <h2>Mighty language support for JetBrains IDEs.</h2>
        <p>
          Adds first-class support for the <a href="https://hassard0.github.io/Mighty/">Mighty</a>
          agent-first programming language across the entire IntelliJ Platform family:
          IntelliJ IDEA (Community + Ultimate), RustRover, PyCharm (Community + Pro),
          WebStorm, GoLand, PhpStorm, RubyMine, CLion, AppCode, DataGrip, and Rider.
        </p>
        <h3>What works everywhere (incl. Community editions)</h3>
        <ul>
          <li>File-type association for <code>.mty</code> files with a syntax-aware icon.</li>
          <li>TextMate-grammar-driven syntax highlighting (bundled grammar).</li>
          <li>Run / check / inspect-cost / test-eval actions for the current Mighty file,
              available from the editor context menu and the <em>Mighty</em> top-level menu.</li>
          <li>Cost dashboard tool window that polls <code>mty inspect --cost --json</code>
              and renders parsed JSON in a sortable TreeTable.</li>
          <li>New-file templates for Mighty agents and modules.</li>
          <li>Color settings page so users can customise highlighting per Mighty token type.</li>
          <li>Settings &gt; Tools &gt; Mighty for binary path + cost cadence.</li>
        </ul>
        <h3>Ultimate / paid IDEs only (via LSP API)</h3>
        <ul>
          <li>LSP-backed completion, hover, go-to-definition, rename, formatting,
              inlay hints, semantic highlighting (via the bundled <code>mty lsp</code> server).</li>
        </ul>
        <p>
          Community editions of IDEA / PyCharm don't ship JetBrains' LSP API, so those
          LSP-driven features are unavailable there. The plugin still loads and the
          TextMate-grammar highlighting + CLI actions are fully functional.
        </p>
        <p>
          Requires the <code>mty</code> CLI on <code>$PATH</code> (or a configured absolute path
          in <em>Settings &gt; Tools &gt; Mighty</em>).
        </p>
    ]]></description>

    <change-notes><![CDATA[
        <h3>0.32.0 — debugger + Community-edition fallback.</h3>
        <ul>
          <li><b>Debug run configuration:</b> new "Mighty Debug" run
              configuration type (Run → Edit Configurations…). Spawns
              the new <code>mty dap</code> Debug Adapter Protocol server
              and forwards stdio. Per-configuration program path,
              optional replay/record trace paths, argv, and stop-on-entry
              toggle.</li>
          <li><b>TextMate fallback:</b> bundled <code>mighty.tmLanguage.json</code>
              registered via the platform's TextMate bundle facility so syntax
              highlighting works on Community editions that lack the LSP API.</li>
          <li><b>Adaptive LSP load:</b> LSP-dependent extensions moved behind
              <code>&lt;depends optional="true" config-file="mighty-lsp.xml"&gt;com.intellij.modules.lsp&lt;/depends&gt;</code>
              so the plugin loads cleanly on Community.</li>
          <li><b>since-build 232:</b> broader compat (IDEA 2023.2+ Community + Ultimate).</li>
          <li><b>Cost TreeTable:</b> the cost tool window now renders a proper
              sortable TreeTable with Date / Provider:Model / Calls / Cost columns
              and a right-click "Copy as JSON" action. (Replaces the v0.31 HTML
              pre-block stub.)</li>
        </ul>
        <h3>0.31.0 — initial JetBrains release.</h3>
        <ul>
          <li>LSP integration over stdio.</li>
          <li>Run/Check/Inspect-Cost/Test-Eval actions.</li>
          <li>Cost tool window (stub, polls every 30s).</li>
          <li>New-file templates for agent + module.</li>
          <li>Color settings page.</li>
        </ul>
    ]]></change-notes>

    <idea-version since-build="232" />

    <!--
      Platform module: every JetBrains IDE provides this, so the plugin
      installs in DataGrip, Rider, and Community editions equally.
    -->
    <depends>com.intellij.modules.platform</depends>

    <!--
      TextMate bundle support is shipped as a bundled plugin in nearly
      every JetBrains IDE, Community and Ultimate alike, via the
      `org.jetbrains.plugins.textmate` plugin. We mark this dependency
      `optional` so the Mighty plugin still installs on the rare IDEs
      that don't ship TextMate (in which case the fallback highlighting
      is unavailable, but file-type detection, file templates, settings,
      and CLI actions all continue to work).
    -->
    <depends optional="true" config-file="mighty-textmate.xml">org.jetbrains.plugins.textmate</depends>

    <!--
      LSP integration. The `com.intellij.modules.lsp` module only exists on
      paid JetBrains IDEs (Ultimate, RustRover, PyCharm Pro, etc.). Marking
      this dependency `optional="true"` with a `config-file` means the
      LSP-only extensions are loaded if-and-only-if the host IDE ships the
      LSP module, so the plugin still installs and runs on Community
      editions — they just don't get the LSP-driven editor features.
    -->
    <depends optional="true" config-file="mighty-lsp.xml">com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- File-type association. -->
        <fileType
            name="Mighty File"
            implementationClass="dev.mighty.jetbrains.MightyFileType"
            fieldName="INSTANCE"
            language="Mighty"
            extensions="mty" />

        <!-- Settings panel. -->
        <applicationConfigurable
            parentId="tools"
            instance="dev.mighty.jetbrains.settings.MightySettingsConfigurable"
            id="dev.mighty.jetbrains.settings"
            displayName="Mighty" />
        <applicationService
            serviceImplementation="dev.mighty.jetbrains.settings.MightySettingsState" />

        <!-- Color customisation. -->
        <colorSettingsPage
            implementation="dev.mighty.jetbrains.MightyColorSettingsPage" />

        <!-- Cost dashboard tool window, docked bottom-right. -->
        <toolWindow
            id="Mighty Cost"
            anchor="bottom"
            secondary="true"
            icon="dev.mighty.jetbrains.MightyIcons.ToolWindow"
            factoryClass="dev.mighty.jetbrains.toolwindow.MightyCostToolWindowFactory" />

        <!-- File templates: surface them under "New > Mighty File > ...". -->
        <internalFileTemplate name="Mighty Agent" />
        <internalFileTemplate name="Mighty Module" />

        <!-- Notification group so actions can show balloons. -->
        <notificationGroup
            id="Mighty"
            displayType="BALLOON"
            isLogByDefault="true" />

        <!--
          v0.32 Track A — Mighty Debug run configuration type. Surfaces
          a "Mighty Debug" entry in the Run/Debug Configurations dialog
          (Run → Edit Configurations…). Each configuration spawns
          `mty dap` over stdio with the configured program + optional
          replay / record trace + argv. The full DAP <-> XDebugger
          frontend is the v0.33 follow-up; today we ship the run
          target plumbing + console mode.
        -->
        <configurationType
            implementation="dev.mighty.jetbrains.debug.MightyDebugConfigurationType" />
    </extensions>

    <actions>
        <!-- Top-level "Mighty" menu next to "Help". -->
        <group
            id="dev.mighty.jetbrains.MainMenu"
            text="_Mighty"
            description="Mighty language actions">
            <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu" />

            <action
                id="dev.mighty.jetbrains.RunMightyFile"
                class="dev.mighty.jetbrains.actions.RunMightyFileAction"
                text="_Run Current Mighty File"
                description="Run the active .mty file with `mty run`.">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift M" />
            </action>
            <action
                id="dev.mighty.jetbrains.CheckMightyFile"
                class="dev.mighty.jetbrains.actions.CheckMightyFileAction"
                text="_Check Current Mighty File"
                description="Type-check the active .mty file with `mty check`." />
            <action
                id="dev.mighty.jetbrains.InspectCost"
                class="dev.mighty.jetbrains.actions.InspectCostAction"
                text="_Inspect Cost"
                description="Run `mty inspect --cost` against the active file or project." />
            <action
                id="dev.mighty.jetbrains.TestEval"
                class="dev.mighty.jetbrains.actions.TestEvalAction"
                text="_Test Eval"
                description="Run `mty test --eval` to evaluate Mighty test suites." />
        </group>

        <!-- Also expose them on the editor context menu for .mty files. -->
        <group id="dev.mighty.jetbrains.EditorPopupGroup" text="Mighty" popup="true">
            <add-to-group group-id="EditorPopupMenu" anchor="last" />
            <reference ref="dev.mighty.jetbrains.RunMightyFile" />
            <reference ref="dev.mighty.jetbrains.CheckMightyFile" />
            <reference ref="dev.mighty.jetbrains.InspectCost" />
            <reference ref="dev.mighty.jetbrains.TestEval" />
        </group>
    </actions>
</idea-plugin>
