##module io
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym std.io.stdin
##sig fn std.io.stdin() -> Stdin
##cap io.stdin
##desc Returns the process stdin handle. Wrap in `BufReader.new(stdin)` for line iteration.
##see std.io.stdout, std.io.stderr, BufReader.new
##example
let r = BufReader.new(std.io.stdin());
for line in r.lines() { log(line?); }
##end

##sym std.io.stdout
##sig fn std.io.stdout() -> Stdout
##cap io.stdout
##desc Returns the process stdout handle. `log` and `println!` share its buffer; flush is implicit on newline.
##see std.io.stderr, std.io.stdin, BufWriter.new, log
##example
std.io.stdout().write_line("hello")?;
##end

##sym std.io.stderr
##sig fn std.io.stderr() -> Stderr
##cap io.stderr
##desc Returns the process stderr handle. Unbuffered by default so diagnostics survive a crash before flush.
##see std.io.stdout, eprintln, panic
##example
std.io.stderr().write_line("error: bad input")?;
##end

##sym write_line
##sig fn Write.write_line(&mut self, s: Str) -> Result<(), IoError>
##desc Write `s` followed by a `\n`. Implemented on every `Write` handle (`Stdout`, `Stderr`, `BufWriter`, file handles).
##see std.io.stdout, BufWriter.new, eprintln
##example
std.io.stdout().write_line("done")?;
##end

##sym std.io.stdin_lock
##sig fn std.io.stdin().lock() -> StdinLock
##cap io.stdin
##desc Acquire an exclusive handle on stdin. Cheap — just takes the per-process mutex. Use when you need stable line semantics across many reads (the unlocked `Stdin` takes/releases the lock around every call).
##see std.io.stdin, BufReader.new
##example
let stdin = std.io.stdin();
let mut handle = stdin.lock();
let mut s = String.new();
handle.read_line(&mut s)?;
##end

