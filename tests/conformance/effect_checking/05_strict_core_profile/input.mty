// MT4002 positive-fire (Gap D — v0.10/v0.11 audit).
//
// The strict `profile = "core"` (set in the case's mighty.toml) bans
// the `alloc` effect. A public fn that uses an `arena { ... }` block
// has its inferred effect set seeded with `alloc` (per
// mty-types/src/effects.rs::infer_and_validate). The Core-profile
// check then emits MT4002.
//
// Activated in v0.11 via the new `CwdGuard` mechanism in
// conformance_full.rs: when a case dir contains a `mighty.toml` the
// harness temporarily chdir's into it so the type checker's
// `load_profile_from_star_toml()` sees the override.
//
// Spec ref: §30 profiles, MT4002 catalog entry.
pub fn allocates() -> Unit {
  arena tmp { 0 }
}
