##module iter
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Iterator.map
##sig fn Iterator.map[T, U](self, f: fn(T) -> U) -> Iterator[U]
##desc Lazily transform each item. Combinator — nothing runs until the consumer drives the iterator.
##see Iterator.filter, Iterator.fold, Iterator.collect
##example
let xs = [1, 2, 3].iter().map(|x| x * 2).collect();
assert_eq(xs, [2, 4, 6]);
##end

##sym Iterator.filter
##sig fn Iterator.filter[T](self, pred: fn(&T) -> Bool) -> Iterator[T]
##desc Lazily keep only items where `pred` returns `true`.
##see Iterator.map, Iterator.fold, Iterator.collect
##example
let evens = (1..10).filter(|x| x % 2 == 0).collect();
##end

##sym Iterator.fold
##sig fn Iterator.fold[T, A](self, init: A, f: fn(A, T) -> A) -> A
##desc Reduce to a single value by threading `init` through `f` for each item. Terminal — drives the iterator.
##see Iterator.map, Iterator.filter, Iterator.sum
##example
let sum = [1, 2, 3].iter().fold(0, |a, x| a + x);
assert_eq(sum, 6);
##end

##sym Iterator.collect
##sig fn Iterator.collect[T, C: FromIterator[T]](self) -> C
##desc Terminal: drain the iterator into a collection. Target type is inferred from context (`Vec[T]`, `HashSet[T]`, ...).
##see Iterator.map, Vec.iter, HashSet.new
##example
let v: Vec[I32] = (1..5).collect();
assert_eq(v.len(), 4);
##end

##sym Iterator.zip
##sig fn Iterator.zip[T, U](self, other: Iterator[U]) -> Iterator[(T, U)]
##desc Pairwise combine. The result stops as soon as either source is exhausted.
##see Iterator.chain, Iterator.enumerate, Iterator.map
##example
let pairs = [1, 2, 3].iter().zip(["a", "b"].iter()).collect();
assert_eq(pairs.len(), 2);
##end

##sym Iterator.chain
##sig fn Iterator.chain[T](self, other: Iterator[T]) -> Iterator[T]
##desc Yield every item of `self`, then every item of `other`. Lazy.
##see Iterator.zip, Iterator.collect, Iterator.map
##example
let all = [1, 2].iter().chain([3, 4].iter()).collect();
assert_eq(all, [1, 2, 3, 4]);
##end

##sym Iterator.take
##sig fn Iterator.take[T](self, n: USize) -> Iterator[T]
##desc Yield at most the first `n` items, then stop.
##see Iterator.skip, Iterator.enumerate, Iterator.collect
##example
let first3 = (1..).take(3).collect();
assert_eq(first3, [1, 2, 3]);
##end

##sym Iterator.skip
##sig fn Iterator.skip[T](self, n: USize) -> Iterator[T]
##desc Drop the first `n` items, then yield the rest.
##see Iterator.take, Iterator.enumerate
##example
let tail = (1..5).skip(2).collect();
assert_eq(tail, [3, 4]);
##end

##sym Iterator.enumerate
##sig fn Iterator.enumerate[T](self) -> Iterator[(USize, T)]
##desc Yield `(index, item)` pairs starting at index `0`.
##see Iterator.zip, Iterator.map, Vec.iter
##example
for (i, name) in names.iter().enumerate() {
  log(format!("{}: {}", i, name));
}
##end

##sym Iterator.sum
##sig fn Iterator.sum[T: Add](self) -> T
##desc Reduce by `+`. Terminal. Works for any item type with a `+ T -> T` Add impl.
##see Iterator.fold, Iterator.collect
##example
let total: I64 = [1, 2, 3].iter().sum();
assert_eq(total, 6);
##end

##sym Iterator.count
##sig fn Iterator.count[T](self) -> USize
##desc Terminal: consume the iterator and return the number of items yielded. O(n) — use `Vec.len` if you already have a sized container.
##see Iterator.fold, Iterator.sum, Vec.len
##example
let n = (1..100).filter(|x| x % 7 == 0).count();
##end

##sym Iterator.any
##sig fn Iterator.any[T](self, pred: fn(T) -> Bool) -> Bool
##desc Terminal: returns `true` as soon as any item satisfies `pred`. Short-circuits on the first match.
##see Iterator.all, Iterator.filter
##example
if names.iter().any(|n| n == "root") { panic("root not allowed"); }
##end

##sym Iterator.all
##sig fn Iterator.all[T](self, pred: fn(T) -> Bool) -> Bool
##desc Terminal: returns `true` iff every item satisfies `pred`. Short-circuits on the first failure. Vacuously true on the empty iterator.
##see Iterator.any, Iterator.filter
##example
assert(xs.iter().all(|x| x > 0));
##end

##sym Iterator.find
##sig fn Iterator.find[T](self, pred: fn(&T) -> Bool) -> Option[T]
##desc Terminal: return the first item satisfying `pred`, or `None`. Short-circuits.
##see Iterator.any, Iterator.filter, Option.is_some
##example
let first_even = (1..).find(|x| x % 2 == 0);
assert_eq(first_even, Some(2));
##end

##sym Iterator.peekable
##sig fn Iterator.peekable[T](self) -> Peekable[T]
##desc Wrap the iterator with a one-item lookahead. `.peek()` returns `Option[&T]` without advancing; the next `.next()` yields the same item.
##see Iterator.take, Iterator.find, Iterator.next
##example
let mut it = [1, 2, 3].iter().peekable();
while let Some(&n) = it.peek() {
  if n > 2 { break; }
  it.next();
}
##end

##sym Iterator.windowed
##sig fn Iterator.windowed[T](self, n: USize) -> Iterator[Vec[T]]
##desc Sliding-window iterator. Yields every contiguous `n`-element window once. The source must be `Clone` — items appear in `n` consecutive windows. Empty for fewer than `n` items.
##see Iterator.chunks, Iterator.take, Iterator.enumerate
##example
let pairs = [1, 2, 3, 4].iter().windowed(2).collect();
assert_eq(pairs, [[1, 2], [2, 3], [3, 4]]);
##end

##sym Iterator.chunks
##sig fn Iterator.chunks[T](self, n: USize) -> Iterator[Vec[T]]
##desc Partition the iterator into non-overlapping `n`-element chunks. The final chunk may be shorter if the source isn't divisible by `n`.
##see Iterator.windowed, Iterator.take, Iterator.skip
##example
let batches = (1..=7).chunks(3).collect();
assert_eq(batches, [[1, 2, 3], [4, 5, 6], [7]]);
##end

##sym Iterator.cycle
##sig fn Iterator.cycle[T: Clone](self) -> Iterator[T]
##desc Repeat the source iterator forever. Requires `T: Clone` so each cycle can reproduce the same items. Pair with `.take(n)` to bound the output.
##see Iterator.take, Iterator.chain, Iterator.enumerate
##example
let rgb: Vec[Str] = ["r", "g", "b"].iter().cycle().take(7).collect();
assert_eq(rgb.len(), 7);
##end

##sym Iterator.min
##sig fn Iterator.min[T: Ord](self) -> Option[T]
##desc Terminal: smallest item by `Ord`. Returns `None` on empty input. Stable — ties yield the first seen.
##see Iterator.max, Iterator.fold, Iterator.find
##example
let lo = [3, 1, 4, 1, 5].iter().copied().min();
assert_eq(lo, Some(1));
##end

##sym Iterator.max
##sig fn Iterator.max[T: Ord](self) -> Option[T]
##desc Terminal: largest item by `Ord`. Returns `None` on empty input. Stable — ties yield the last seen.
##see Iterator.min, Iterator.fold, Iterator.sum
##example
let hi = [3, 1, 4, 1, 5].iter().copied().max();
assert_eq(hi, Some(5));
##end

##sym Iterator.flat_map
##sig fn Iterator.flat_map[T, U, I: Iterator[U]](self, f: fn(T) -> I) -> Iterator[U]
##desc Map each item to a sub-iterator and flatten. Equivalent to `.map(f).flatten()`.
##see Iterator.map, Iterator.filter, Iterator.collect
##example
let words = ["hi there", "hello world"].iter().flat_map(|s| s.split(" ")).collect();
##end

##sym Iterator.rev
##sig fn Iterator.rev[T](self) -> Iterator[T]
##desc Reverse the iteration order. Requires the source to implement DoubleEndedIterator (`Vec.iter`, ranges, etc.).
##see Iterator.take, Iterator.skip, Iterator.collect
##example
let backward: Vec[I32] = (1..=3).rev().collect();
assert_eq(backward, [3, 2, 1]);
##end

##sym Iterator.step_by
##sig fn Iterator.step_by[T](self, step: USize) -> Iterator[T]
##desc Yield every `step`-th item, starting at index 0. `step_by(1)` is the identity; `step_by(0)` panics.
##see Iterator.skip, Iterator.take, Iterator.enumerate
##example
let evens: Vec[I32] = (0..10).step_by(2).collect();
assert_eq(evens, [0, 2, 4, 6, 8]);
##end

##sym Iterator.scan
##sig fn Iterator.scan[B, F: FnMut(&mut St, T) -> Option[B]](self, init: St, f: F) -> Scan[Self, St, F]
##desc Like `fold` but emits each intermediate state as an iterator item. Stops when `f` returns `None`. Canonical use: running totals, parser state machines, cumulative sums.
##see Iterator.fold, Iterator.map, Iterator.take_while
##example
let running_sums: Vec[I64] = [1, 2, 3, 4]
  .iter()
  .scan(0, |acc, x| { *acc += x; Some(*acc) })
  .collect();
// [1, 3, 6, 10]
##end

##sym Iterator.take_while
##sig fn Iterator.take_while[P: FnMut(&T) -> Bool](self, pred: P) -> TakeWhile[Self, P]
##desc Yield items while `pred` returns true; stop at the first false. Unlike `filter`, the iterator terminates after the first rejection — useful for sorted streams and parse-prefix idioms.
##see Iterator.skip_while, Iterator.filter, Iterator.take
##example
let small: Vec[I64] = nums.iter().take_while(|&n| *n < 100).collect();
##end

##sym Iterator.skip_while
##sig fn Iterator.skip_while[P: FnMut(&T) -> Bool](self, pred: P) -> SkipWhile[Self, P]
##desc Skip items while `pred` returns true; from the first false on, yield everything (including subsequent items where `pred` would be true again). Mirror image of `take_while`.
##see Iterator.take_while, Iterator.skip, Iterator.filter
##example
let from_first_neg: Vec[I64] = nums.iter().skip_while(|&n| *n >= 0).copied().collect();
##end

##sym Iterator.partition
##sig fn Iterator.partition[B: Default + Extend[T], P: FnMut(&T) -> Bool](self, pred: P) -> (B, B)
##desc Split the iterator into two collections by predicate: `(matching, rejected)`. Single pass; both collections preserve original order. The canonical "sort items into two buckets" combinator.
##see Iterator.filter, Iterator.group_by, Iterator.collect
##example
let (evens, odds): (Vec[I32], Vec[I32]) = (1..10).partition(|&n| n % 2 == 0);
##end

##sym Iterator.group_by
##sig fn Iterator.group_by[K: Eq, F: FnMut(&T) -> K](self, key: F) -> GroupBy[Self, F]
##desc Group CONSECUTIVE items sharing the same key. NOT a SQL-style global GROUP BY — the input must already be sorted by key for total grouping. Each group yields `(key, sub-iterator)`.
##see Iterator.partition, Iterator.fold, GroupBy.Provider
##example
let sorted: Vec<_> = items.iter().sorted_by_key(|x| x.kind).collect();
for (kind, group) in sorted.iter().group_by(|x| x.kind) {
  log(format("{}: {}", kind, group.count()));
}
##end

##sym Iterator.position
##sig fn Iterator.position[P: FnMut(T) -> Bool](&mut self, pred: P) -> Option[USize]
##desc Index of the first item for which `pred` returns true, or `None`. Consumes the iterator up to (but not including) the next item. The index counterpart of `find`.
##see Iterator.find, Iterator.any, Iterator.enumerate
##example
let idx = nums.iter().position(|&n| n > 100);
##end

##sym Iterator.last
##sig fn Iterator.last(self) -> Option[T]
##desc Consume the iterator and return the last yielded item, or `None` on an empty iterator. O(n) for the general case (specialised on `DoubleEndedIterator` for O(1) `.rev().next()`).
##see Iterator.next, Iterator.rev, Iterator.count
##example
let last_line = std.fs.read_to_string(p)?.lines().last();
##end

##sym Iterator.nth
##sig fn Iterator.nth(&mut self, n: USize) -> Option[T]
##desc Return the nth item (zero-indexed), or `None` if the iterator runs out first. Advances the iterator — subsequent `next()` calls start AFTER the returned item.
##see Iterator.next, Iterator.skip, Iterator.position
##example
let third = (10..100).nth(3); // Some(13)
##end

##sym Iterator.product
##sig fn Iterator.product[T: Mul + One](self) -> T
##desc Multiply every item. Empty iterator → `T::one()` (`1` for integers, `1.0` for floats). The `product` half of the sum/product pair.
##see Iterator.sum, Iterator.fold, Iterator.max
##example
let factorial: U64 = (1u64..=5).product(); // 120
##end

##sym Iterator.copied
##sig fn Iterator.copied[T: Copy](self) -> Copied[Self]
##desc Transform an iterator of `&T` into an iterator of `T` by `Copy`. Cheaper than `.cloned()` because it dispatches on `Copy` rather than `Clone`. The right move after `Vec.iter()` on a primitive element type.
##see Iterator.cloned, Iterator.map, Iterator.collect
##example
let doubled: Vec[I32] = nums.iter().copied().map(|n| n * 2).collect();
##end

##sym Iterator.cloned
##sig fn Iterator.cloned[T: Clone](self) -> Cloned[Self]
##desc Transform an iterator of `&T` into an iterator of `T` by `Clone`. Use when `T: Clone` but not `Copy` (e.g. `String`).
##see Iterator.copied, Iterator.map, Iterator.collect
##example
let owned: Vec[String] = strs.iter().cloned().collect();
##end

##sym Iterator.max_by
##sig fn Iterator.max_by[F: FnMut(&T, &T) -> Ordering](self, cmp: F) -> Option[T]
##desc Maximum by an arbitrary comparator. Use when `T` doesn't impl `Ord` (e.g. floats — `f64::total_cmp` is the safe choice).
##see Iterator.max, Iterator.min_by, Iterator.fold
##example
let largest = floats.iter().copied().max_by(|a, b| a.total_cmp(b));
##end

##sym Iterator.min_by
##sig fn Iterator.min_by[F: FnMut(&T, &T) -> Ordering](self, cmp: F) -> Option[T]
##desc Minimum by an arbitrary comparator. Mirror of `max_by`.
##see Iterator.min, Iterator.max_by, Iterator.fold
##example
let smallest = floats.iter().copied().min_by(|a, b| a.total_cmp(b));
##end

##sym Iterator.max_by_key
##sig fn Iterator.max_by_key[K: Ord, F: FnMut(&T) -> K](self, key: F) -> Option[T]
##desc Item with the maximum projected key. Compared to `max_by`, this is the right choice when there's a natural "size" projection.
##see Iterator.max, Iterator.min_by_key, Iterator.max_by
##example
let longest = strs.iter().max_by_key(|s| s.len());
##end

##sym Iterator.min_by_key
##sig fn Iterator.min_by_key[K: Ord, F: FnMut(&T) -> K](self, key: F) -> Option[T]
##desc Item with the minimum projected key. Mirror of `max_by_key`.
##see Iterator.min, Iterator.max_by_key, Iterator.min_by
##example
let shortest = strs.iter().min_by_key(|s| s.len());
##end

##sym Iterator.by_ref
##sig fn Iterator.by_ref(&mut self) -> &mut Self
##desc Borrow the iterator so a combinator chain doesn't consume it. Lets you split a stream — take the first N items, then consume the rest separately.
##see Iterator.take, Iterator.skip, Iterator.peekable
##example
let head: Vec<_> = iter.by_ref().take(3).collect();
let tail: Vec<_> = iter.collect();
##end

##sym Iterator.inspect
##sig fn Iterator.inspect[F: FnMut(&T)](self, f: F) -> Inspect[Self, F]
##desc Run `f` on each item as it passes through, but pass the item unchanged downstream. The lazy print-debug equivalent of `map(|x| { dbg!(x); x })`.
##see Iterator.map, Iterator.for_each, log
##example
let total: I64 = nums.iter().inspect(|n| log(format("{}", n))).sum();
##end

##sym Iterator.for_each
##sig fn Iterator.for_each[F: FnMut(T)](self, f: F)
##desc Run `f` on each item, consuming the iterator. The functional counterpart to `for x in iter { f(x) }`. Returns `()` — use `fold` if you want an accumulator.
##see Iterator.fold, Iterator.inspect, Iterator.map
##example
items.iter().for_each(|x| log(format("{}", x)));
##end

