// Pure arithmetic — no IO, no clock, no random.
// Recorded trace MUST be empty (zero events).
fn add(a: I64, b: I64) -> I64 {
  a + b
}

fn main() {
  let x = add(40, 2)
  let y = add(x, x)
  // No log() call: log itself is an effect on the host stdout binding.
  // Tail expression keeps `y` live so the compiler doesn't dead-code
  // the chain, but produces no observable trace event.
  let _ = y
}
