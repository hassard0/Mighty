{
  "name": "Mighty",
  "image": "mighty-lang/devcontainer:0.30.1",

  "remoteUser": "vscode",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",

  "mounts": [
    "source=mighty-mty-cache,target=/home/vscode/.cache/mty,type=volume",
    "source=mighty-cargo-cache,target=/home/vscode/.cargo/registry,type=volume"
  ],

  "containerEnv": {
    "MTY_LOG": "info"
  },

  "postCreateCommand": "mty --version && echo \"Mighty $(mty --version) ready\"",

  "customizations": {
    "vscode": {
      "extensions": [
        "hassard0.mighty-language",
        "rust-lang.rust-analyzer",
        "tamasfe.even-better-toml",
        "EditorConfig.EditorConfig",
        "esbenp.prettier-vscode",
        "ms-python.python"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "terminal.integrated.defaultProfile.linux": "bash",
        "mighty.lsp.serverPath": "mty",
        "mighty.lsp.serverArgs": ["lsp"]
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "configureZshAsDefaultShell": false,
      "upgradePackages": false
    }
  }
}
