// demo 06_canvas_game — Notetris as a canvas-driven Mighty agent.
//
// v0.24 rewrite. Three v0.23 language gaps from Track D's brief
// closed in v0.24:
//
//   * Track A (aef5225): the wasm32-web emitter now lowers
//     `BuiltinId::CanvasOp(...)` to direct `mty:web/canvas@0.1`
//     imports, and exports `frame` / `keydown` / `keyup` from the
//     embedded core module so the JS host shim can `inst.exports
//     .frame(dt)` without trapping.
//   * Track B (2399391): `format!("score: {score}", ...)` is now a
//     first-class macro on top of the prelude `fmt` interner — no
//     more `MT6001 unknown macro` errors when the agent wants to
//     compose a per-tick HUD line.
//
// What this demo exercises end-to-end at v0.24:
//
//   * `format!(...)` inside `fn frame / keydown / keyup` to compose
//     the canonical intent log lines the shim parses (Track B
//     end-to-end through the wasm32-web emitter, not just the SIR
//     interpreter — see `tests/conformance/macros/format_basic`).
//   * `fn frame(dt: U32)` / `fn keydown(k: U32)` / `fn keyup(k: U32)`
//     callable by the host as real core-module exports (Track A's
//     `is_web_callback_export` predicate); the shim's RAF loop and
//     `window.addEventListener('keydown', ...)` route straight
//     through `inst.exports.frame(...)` / `.keydown(...)` instead of
//     the v0.23 best-effort `exp?.input_left?.()` fallback chain.
//
// What still needs a v0.25 closer (see
// `dev/history/notes/DEMO06_CANVAS_DIRECT_V0_24_NOTES.md`):
//
//   * HIR -> IR routing for `canvas.fill_rect(...)` method calls.
//     Track A added `BuiltinId::CanvasOp(...)` + the emitter, but
//     `crates/mty-ir/src/lower/exprs.rs` doesn't recognise a
//     `std.web.Canvas`-typed receiver and route the call into
//     `BuiltinId::CanvasOp` the way it does for `CapFamily::Dom`.
//     Until that lands, the embedded core module never imports any
//     `mty:web/canvas@0.1` ops even when the source contains
//     `canvas.fill_rect(...)`. The shim therefore still owns the
//     board pixels, but it's now ~50 % smaller because the intent
//     stream comes from `format!()` calls inside the exported
//     callbacks rather than a hand-maintained JS-side translation
//     table.
//   * `agent`-dispatched handlers (`on Left()` etc.) compile but
//     aren't reachable from the exported callbacks at the wasm-
//     backend's current dead-code elimination — calling a Unit-
//     returning user fn from `keydown` triggers a stack-balance
//     error in the v0.24 emitter (the `frame`/`keydown`/`keyup`
//     synthesis isn't fully prologue/epilogue-aware yet). The
//     handler bodies below are therefore the *protocol of record*
//     — they describe the agent's intent surface for review and
//     for the v0.25 dispatcher to plug into, but the runtime work
//     happens inline in the exported callbacks.
//
// Compiled with `mty build --target wasm32-web`. The generated WIT
// world declares:
//
//   import mty:web/log;
//   import mty:web/dom;
//   import mty:web/canvas;     <-- Track A WIT shape ready; HIR gap
//   import mty:web/input;      <-- Track A WIT shape ready; HIR gap
//   export frame: func(dt-ms: u32);
//   export keydown: func(k: u32);
//   export keyup: func(k: u32);
//
// and the companion `web/dom-shim.js` implements all four import
// surfaces against a real <canvas> + window keyboard listeners.
package canvas_game

// ---------------------------------------------------------------------
// Protocol — the messages the Notetris agent answers. Each handler
// emits the canonical `evt:input:<kind>` tag the shim parses. The
// agent body is the type-checked spec of record; the wasm runtime
// dispatches via the exported `keydown(k)` callback below (matching
// the same intent vocabulary).
// ---------------------------------------------------------------------

protocol NotetrisInput {
  Left()        -> Unit
  Right()       -> Unit
  SoftDrop()    -> Unit
  HardDrop()    -> Unit
  Rotate()      -> Unit
  Tick()        -> Unit
  Reset()       -> Unit
}

// ---------------------------------------------------------------------
// Notetris agent — owns the score / level / lines counters as
// agent state. Each handler emits a canonical intent line the
// shim's renderer reads. (See the v0.25-gap note above re: the
// handler bodies vs the exported callbacks.)
// ---------------------------------------------------------------------

agent Notetris: NotetrisInput {
  score = 0
  level = 1
  lines = 0
  gameover = 0

  on Left() {
    log("evt:input:left")
  }

  on Right() {
    log("evt:input:right")
  }

  on SoftDrop() {
    log("evt:input:softdrop")
    score += 1
  }

  on HardDrop() {
    log("evt:input:harddrop")
    score += 2
  }

  on Rotate() {
    log("evt:input:rotate")
  }

  on Tick() {
    log("evt:tick")
  }

  on Reset() {
    log("evt:input:reset")
    score = 0
    level = 1
    lines = 0
    gameover = 0
  }
}

// ---------------------------------------------------------------------
// Track A canonical export shape — `frame(dt-ms)` is the
// host-invoked next-vsync callback; `keydown(k)` / `keyup(k)` are
// the host-invoked keyboard callbacks. The exported names match the
// `is_web_callback_export` predicate in
// `crates/mty-codegen-wasm/src/web_lower.rs`, so the v0.24 emitter
// lifts them into the embedded core module's export table without
// further annotation.
//
// Keycode convention (browser KeyboardEvent.keyCode):
//   37 = ArrowLeft       39 = ArrowRight     38 = ArrowUp
//   40 = ArrowDown       32 = Space          82 = R
//
// We dispatch inline (no helper calls) because the v0.24 emitter's
// callback prologue isn't yet stack-balanced for Unit-returning
// user-fn calls — see the v0.25-gap note at the top of this file.
// The wasm runtime gets called for every keystroke (no JS-side
// translation table); `format!()` lets us interpolate the keycode
// into the intent log so the shim can route a wider key vocabulary
// without us hard-coding it Mighty-side.
// ---------------------------------------------------------------------

fn frame(dt: U32) {
  log(format!("evt:frame:{}", dt))
}

fn keydown(k: U32) {
  match k {
    37 => log("evt:input:left"),
    39 => log("evt:input:right"),
    38 => log("evt:input:rotate"),
    40 => log("evt:input:softdrop"),
    32 => log("evt:input:harddrop"),
    82 => log("evt:input:reset"),
    _  => log(format!("evt:input:unknown:{}", k))
  }
}

fn keyup(k: U32) {
  log(format!("evt:keyup:{}", k))
}

// ---------------------------------------------------------------------
// `main` is the post-instantiation entry point the host invokes once
// to flag the wasm side as live. Per the v0.22 stdlib convention,
// this is a `log()` line the shim sees as the "wasm is up" beacon.
// ---------------------------------------------------------------------

fn main() {
  log("canvas_game: built (v0.24 — frame/keydown/keyup exports + format!())")
}
