fn lower_paren_expr(n: USize) -> USize {
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_expr_node_kind(ck) == true {
      return lower_expr(c)
    }
    i = i + 1
  }
  std.io.hir_emit_expr("Error")
}

fn lower_tuple_expr(n: USize) -> USize {
  let id = std.io.hir_emit_expr("Tuple")
  let nc = child_count(n)
  let mut i: USize = 0
  loop {
    if i >= nc { break }
    let c = nth_child(n, i)
    let ck = node_kind(c)
    if is_expr_node_kind(ck) == true {
      let _ = lower_expr(c)
    }
