# Rust
/target
# v0.46 T1: parallel-worktree builds set CARGO_TARGET_DIR=target-<track>
# (see feedback_mighty_target_dir_isolation). Match every such per-worktree
# target dir so a misconfigured editor doesn't accidentally try to stage it.
/target-*
**/*.rs.bk
Cargo.lock.bak

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Snapshot review staging
**/*.snap.new
**/.pending-snap

# Local-only env / scratch
/.env
/.scratch/
/tmp/

# Mighty build output (when codegen lands)
*.sdprof
*.smeta.cache
*.mtyprof
*.mmeta.cache

# mkdocs build output
/site/

# cargo-fuzz artifacts
/fuzz/target/
/fuzz/corpus/
/fuzz/artifacts/

# Release tooling scratch
/dist/
*.tar.gz.sig
*.tar.gz.asc
