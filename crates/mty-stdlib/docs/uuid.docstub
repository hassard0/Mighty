##end

##sym std.uuid.Uuid.version
##sig fn std.uuid.Uuid.version(self: &Uuid) -> U8
##desc UUID version digit per RFC 9562 (high nibble of byte 6). 4 for v4, 7 for v7.
##see std.uuid.Uuid.v4, std.uuid.Uuid.v7
