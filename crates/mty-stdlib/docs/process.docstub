##module process
##generated_from STDLIB_EXAMPLES (run `cargo run -p mty-doc --bin regen-stdlib-docstubs` to re-emit)

##sym Command.new
##sig fn Command.new(program: Str) -> Command
##cap process.exec
##desc Builder for an OS subprocess. Fluent `.arg`/`.env`/`.spawn`/`.exec` mirror the `std::process::Command` ergonomics.
##see Command.arg, Command.args, Command.exec, Command.spawn, std.process.spawn
##example
let out = Command.new("git").arg("status").exec()?;
log(out.stdout);
##end

##sym Command.arg
##sig fn Command.arg(&mut self, a: Str) -> &mut Command
##desc Append one argument. Each call is a distinct argv slot — no shell splitting.
##see Command.new, Command.args, Command.env
##example
let mut c = Command.new("git");
c.arg("log").arg("--oneline");
##end

##sym Command.args
##sig fn Command.args(&mut self, xs: &[Str]) -> &mut Command
##desc Append every entry of `xs` as a separate argv slot.
##see Command.arg, Command.new
##example
Command.new("ls").args(&["-la", "/tmp"]).exec()?;
##end

##sym Command.env
##sig fn Command.env(&mut self, key: Str, value: Str) -> &mut Command
##desc Set one environment variable for the child. Repeated keys overwrite; `Command.env_clear` (separate call) wipes inherited env first.
##see Command.new, Command.arg, std.process.exec
##example
Command.new("node").arg("build.js").env("NODE_ENV", "production").exec()?;
##end

##sym Command.exec
##sig fn Command.exec(&mut self) -> Result<ProcessOutput, ProcessError>
##cap process.exec
##desc Run to completion, collect stdout+stderr, and return on exit. Blocks the current task; combine with `spawn` if you need to interleave I/O.
##see Command.spawn, Command.new, ProcessExit
##example
let out = Command.new("echo").arg("hi").exec()?;
assert_eq(out.stdout.trim_end(), "hi");
##end

##sym Command.spawn
##sig fn Command.spawn(&mut self) -> Result<Child, ProcessError>
##cap process.exec
##desc Start the child without waiting. Returns a `Child` handle — call `.wait()` (sync) or `.wait_async()` (yields the task) to collect the exit.
##see Command.exec, std.process.wait, std.process.kill
##example
let mut child = Command.new("sleep").arg("1").spawn()?;
let exit = child.wait()?;
##end

##sym std.process.spawn
##sig fn std.process.spawn(program: Str, args: &[Str]) -> Result<Child, ProcessError>
##cap process.exec
##desc Convenience over `Command.new(program).args(args).spawn()`. Returns the child handle for `.wait()` / `.kill()`.
##see std.process.exec, std.process.kill, std.process.wait, Command.spawn
##example
let child = std.process.spawn("sleep", &["5"])?;
std.process.kill(child)?;
##end

##sym std.process.exec
##sig fn std.process.exec(program: Str, args: &[Str]) -> Result<ProcessOutput, ProcessError>
##cap process.exec
##desc Run the program, block until exit, return the captured stdout+stderr+exit code as `ProcessOutput`.
##see std.process.spawn, Command.exec, ProcessExit
##example
let out = std.process.exec("git", &["rev-parse", "HEAD"])?;
let sha = out.stdout.trim_end();
##end

##sym std.process.wait
##sig fn std.process.wait(&mut child: Child) -> Result<ProcessExit, ProcessError>
##desc Block the current task until the child exits. Returns the exit status. Idempotent — calling on a finished child returns the cached exit.
##see std.process.spawn, std.process.kill, ProcessExit
##example
let mut c = std.process.spawn("sleep", &["1"])?;
let exit = std.process.wait(&mut c)?;
log(format!("code={}", exit.code));
##end

##sym std.process.kill
##sig fn std.process.kill(child: Child) -> Result<(), ProcessError>
##cap process.exec
##desc Send SIGTERM (Unix) / TerminateProcess (Windows) to the child. Use `.wait()` afterwards to drain the exit.
##see std.process.wait, std.process.spawn, Command.spawn
##example
let c = std.process.spawn("sleep", &["30"])?;
std.process.kill(c)?;
##end

##sym ProcessExit
##sig struct ProcessExit { code: I32, signal: Option<I32> }
##desc The result of waiting on a child. `code` is the process exit status (0 = success). On Unix, `signal` carries the signal number when the child was killed; on Windows it is always `None`.
##see std.process.wait, std.process.exec, Command.exec
##example
let exit = std.process.wait(&mut child)?;
if exit.code != 0 { panic("child failed"); }
##end

##sym Command.current_dir
##sig fn Command.current_dir(&mut self, dir: Str) -> &mut Command
##desc Set the child's working directory. Inherits the parent's `cwd` by default. Equivalent to `chdir(dir); exec(program)` from the child's perspective.
##see Command.new, Command.env, Command.exec
##example
Command.new("cargo").arg("build").current_dir("./crates/core").exec()?;
##end

##sym Command.env_clear
##sig fn Command.env_clear(&mut self) -> &mut Command
##desc Drop every inherited environment variable. Subsequent `.env(k, v)` calls re-populate the child's env from scratch. Useful for hermetic child invocations (CI, sandboxing).
##see Command.env, Command.new, Command.exec
##example
Command.new("sh").arg("-c").arg("env | wc -l")
  .env_clear()
  .env("PATH", "/usr/bin")
  .exec()?;
##end

##sym Command.stdout_piped
##sig fn Command.stdout_piped(&mut self) -> &mut Command
##desc Redirect the child's stdout to a pipe captured by the parent. Required before `spawn()` if you want to incrementally read the child's output; `exec()` captures stdout automatically.
##see Command.spawn, Command.stderr_piped, Command.exec
##example
let mut child = Command.new("git").arg("log").stdout_piped().spawn()?;
let out = child.stdout.take().unwrap();
for line in BufReader.new(out).lines() { log(line?); }
##end

##sym Command.stderr_piped
##sig fn Command.stderr_piped(&mut self) -> &mut Command
##desc Redirect the child's stderr to a pipe captured by the parent. Same shape as `stdout_piped`. Pair both if you need to interleave diagnostics with stdout reads.
##see Command.stdout_piped, Command.spawn
##example
let mut child = Command.new("build").stdout_piped().stderr_piped().spawn()?;
##end

##sym Command.output
##sig fn Command.output(&mut self) -> Result[ProcessOutput, ProcessError]
##cap process.exec
##desc Synonym for `Command.exec` — keeps the `std::process::Command` muscle memory for migrating Rust code. Runs to completion and returns captured stdout / stderr / exit.
##see Command.exec, Command.spawn, ProcessOutput
##example
let out = Command.new("echo").arg("hi").output()?;
assert_eq(out.stdout.trim_end(), "hi");
##end

##sym ProcessOutput
##sig struct ProcessOutput { stdout: Str, stderr: Str, exit: ProcessExit }
##desc Result of `Command.exec` / `Command.output` / `std.process.exec`. `stdout` / `stderr` are decoded as UTF-8 with lossy replacement for invalid sequences. The raw bytes path is on the v0.40 roadmap.
##see Command.exec, ProcessExit, Command.output
##example
let out = Command.new("git").arg("rev-parse").arg("HEAD").exec()?;
let sha = out.stdout.trim_end();
assert!(out.exit.success());
##end

##sym ProcessExit.success
##sig fn ProcessExit.success(&self) -> Bool
##desc True iff the child exited normally with code 0. Treats signal terminations (Unix) as non-success regardless of the wrapped signal number.
##see ProcessExit, std.process.wait, Command.exec
##example
let exit = std.process.wait(&mut child)?;
if !exit.success() { panic(format!("failed code={}", exit.code)); }
##end

