// selfhost/lexer/lexer.sd
//
// Self-hosted Mighty lexer (v0.4) — STATIC SOURCE FORM.
//
// Mirrors the behavior of crates/mty-syntax/src/lexer.rs as a
// hand-written state machine in Mighty source. `mty check`s clean
// and demonstrates the full token surface (every keyword, every
// punctuation token, every literal kind, comments, identifiers).
//
// ## v0.4 status: SUBSET — compiles, does not execute end-to-end
//
// The v0.3 SIR interpreter lowers `while` / `loop` / `for` as
// **single-iteration** by design (see
// crates/mty-sir/src/lower/exprs.rs lower_while/lower_loop/lower_for
// — explicit "Slice 6: avoid infinite loops at run time by jumping
// straight to exit"). A real lexer iterates over the source, so this
// hard-blocks running the self-hosted lexer through `mty run` until
// the v0.5 interpreter gains real iterative loops.
//
// The bootstrap test (crates/mty-driver/tests/selfhost_lexer.rs) is
// therefore split:
//   1. compile + type/borrow-check the lexer source (passes in v0.4)
//   2. round-trip a single token via the std.io host bridge (the
//      first FN_KW lex works; the loop then terminates after one
//      iteration — documented v0.3 gap)
//   3. full diff against the Rust lexer (gated on the v0.5 loop fix)
//
// See SELFHOST_V0_4_NOTES.md for the full gap catalog and
// docs/internals/self-hosting.md for the roadmap.
//
// ## Why one file in v0.4
//
// The v0.4 `mty check` driver compiles a single `.sd` file at a
// time; cross-file `use selfhost_lexer.SyntaxKind` resolution is
// waiting on the v0.5 `mty-pkg` pass. We therefore inline the
// `SyntaxKind` enum + helpers here. The decomposed view lives in
// `lib.sd` and `syntax_kind.sd` for documentation purposes — see
// `selfhost/README.md` for the roadmap.

package selfhost_lexer

// ---- SyntaxKind --------------------------------------------------------
//
// Mighty mirror of the token variants of crates/mty-syntax/src/syntax_kind.rs.
// Order kept identical so the bootstrap test can compare by name.

pub enum SyntaxKind {
  // ---- Trivia ----
  WHITESPACE
  LINE_COMMENT
  BLOCK_COMMENT
  DOC_COMMENT

  // ---- Literals ----
  INT_LITERAL
  FLOAT_LITERAL
  DURATION_LITERAL
  SIZE_LITERAL
  STRING_LITERAL
  CHAR_LITERAL
  HTML_LITERAL
  TRUE_KW
  FALSE_KW

  // ---- Keywords (spec §3.3) ----
  AGENT_KW
  ARENA_KW
  AS_KW
  ASYNC_KW
  AWAIT_KW
  BUDGET_KW
  CAP_KW
  CONST_KW
  EFFECT_KW
  ELSE_KW
  ENUM_KW
  EXTERN_KW
  FN_KW
  FOR_KW
  IF_KW
  IMPL_KW
  IMPORT_KW
  IN_KW
  LET_KW
  LOOP_KW
  MATCH_KW
  MOD_KW
  MOVE_KW
  MUT_KW
  ON_KW
  PACKAGE_KW
  PROTOCOL_KW
  PUB_KW
  REF_KW
  RETURN_KW
  SELF_KW
  SPAWN_KW
  STATE_KW
  STRUCT_KW
  TASK_KW
  TRAIT_KW
  TYPE_KW
  UNSAFE_KW
  USE_KW
  WHERE_KW
  WHILE_KW
  WITH_KW
  YIELD_KW
  EXPORT_KW
  SUP_KW
  SANDBOX_KW
  CHILD_KW
  ON_FAIL_KW
  RESTART_KW
  BACKOFF_KW
  UP_TO_KW
  DETACH_KW
  REQUIRES_KW
  MACRO_KW
  RUN_KW
  JOIN_KW
  SCOPE_KW
  DYN_KW
  DERIVE_KW

  // ---- Identifiers ----
  IDENT

  // ---- Punctuation ----
  L_PAREN
  R_PAREN
  L_BRACE
  R_BRACE
  L_BRACK
  R_BRACK
  COMMA
  SEMI
  COLON
  COLON_COLON
  DOT
  DOT_DOT
  DOT_DOT_EQ
  FAT_ARROW
  THIN_ARROW
  AT
  QUESTION
  BANG
  AMP
  AMP_AMP
  PIPE
  PIPE_PIPE
  CARET
  EQ
  EQ_EQ
  BANG_EQ
  LT
  LT_EQ
  GT
  GT_EQ
  SHL
  SHR
  PLUS
  MINUS
  STAR
  SLASH
  PERCENT
  PLUS_EQ
  MINUS_EQ
  STAR_EQ
  SLASH_EQ
  PERCENT_EQ
  AMP_EQ
  PIPE_EQ
  CARET_EQ
  SHL_EQ
  SHR_EQ
  HASH

  // ---- Special ----
  ERROR
  EOF
}

// ---- Host bridge -------------------------------------------------------
//
// The bootstrap host (a Rust impl of `Host::effect_call`) services
// these. They are the *only* place the lexer learns about the source.
//
// We call them as method invocations on the registered prelude module
// `std.io`. The HIR->SIR lowerer recognises a module-typed receiver
// and rewrites `std.io.lex_init(src)` into
//
//   Stmt::EffectInvoke {
//     effect: io,
//     op: EffectOp::GenericCall { path: ["std", "io"], method: "lex_init" },
//     args: [src],
//   }
//
// which the interpreter routes through `Host::effect_call`. (An
// `extern { fn lex_init(...) }` declaration would instead resolve to
// a body-less user fn that returns Unit, because `Item::ExternBlock`
// lowering installs a trivial-return shell for each extern fn — see
// SELFHOST_V0_4_NOTES.md "extern blocks short-circuit to Unit".)
//
// The five call sites:
//
//   std.io.lex_init(src)              caches source on the host
//   std.io.lex_len()                  returns USize length
//   std.io.lex_byte_at(i)             byte at offset, or 256 for OOB
//   std.io.lex_slice(start, end)      substring as Str
//   std.io.lex_emit(kind, s, e)       token sink

// ---- ASCII helpers -----------------------------------------------------

fn is_space(b: U32) -> Bool {
  b == 32 || b == 9 || b == 13 || b == 10
}

fn is_digit(b: U32) -> Bool { b >= 48 && b <= 57 }
fn is_lower(b: U32) -> Bool { b >= 97 && b <= 122 }
fn is_upper(b: U32) -> Bool { b >= 65 && b <= 90 }
fn is_alpha(b: U32) -> Bool { is_lower(b) || is_upper(b) }
fn is_ident_start(b: U32) -> Bool { is_alpha(b) || b == 95 } // '_'
fn is_ident_cont(b: U32) -> Bool { is_ident_start(b) || is_digit(b) }

// ---- Token sink --------------------------------------------------------

fn emit(kind_name: Str, start: USize, end: USize) -> Unit {
  std.io.lex_emit(kind_name, start, end)
}

// ---- Scanner primitives ------------------------------------------------

fn scan_whitespace(start: USize) -> USize {
  let mut i = start
  let n = std.io.lex_len()
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    let space = is_space(b)
    if space == false { break }
    i = i + 1
  }
  emit("WHITESPACE", start, i)
  i
}

fn scan_line_comment(start: USize) -> USize {
  // Caller already saw `//`. Determine doc-vs-line by peeking the 3rd
  // byte: `///` is DOC_COMMENT, `//` is LINE_COMMENT.
  let n = std.io.lex_len()
  let mut is_doc = false
  if start + 2 < n {
    let third = std.io.lex_byte_at(start + 2)
    if third == 47 { is_doc = true }
  }
  let mut i = start + 2
  if is_doc { i = i + 1 } // skip the third '/'
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    if b == 10 { break } // '\n' — keep newline as whitespace next round
    i = i + 1
  }
  if is_doc {
    emit("DOC_COMMENT", start, i)
  } else {
    emit("LINE_COMMENT", start, i)
  }
  i
}

fn scan_block_comment(start: USize) -> USize {
  // Caller already saw `/*`. Block comments do not nest in v0.1.
  let n = std.io.lex_len()
  let mut i = start + 2
  loop {
    if i + 1 >= n {
      i = n
      break
    }
    let a = std.io.lex_byte_at(i)
    let c = std.io.lex_byte_at(i + 1)
    if a == 42 && c == 47 { // '*' '/'
      i = i + 2
      break
    }
    i = i + 1
  }
  emit("BLOCK_COMMENT", start, i)
  i
}

fn scan_ident_or_keyword(start: USize) -> USize {
  // Caller already verified first byte is is_ident_start.
  let n = std.io.lex_len()
  let mut i = start + 1
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    let cont = is_ident_cont(b)
    if cont == false { break }
    i = i + 1
  }
  let text = std.io.lex_slice(start, i)
  let kind_str = ident_kind_name(text)
  emit(kind_str, start, i)
  i
}

fn scan_number(start: USize) -> USize {
  // INT, FLOAT, DURATION, or SIZE — distinguished by the suffix.
  let n = std.io.lex_len()
  let mut i = start
  // Mantissa.
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    let d = is_digit(b)
    let und = b == 95
    if d == false {
      if und == false { break }
    }
    i = i + 1
  }
  // Fraction? `.` followed by digit, else stop (so `1..10` stays an int).
  let mut is_float = false
  if i + 1 < n {
    let dot = std.io.lex_byte_at(i)
    let next = std.io.lex_byte_at(i + 1)
    if dot == 46 {
      let nd = is_digit(next)
      if nd == true {
        is_float = true
        i = i + 1
        loop {
          if i >= n { break }
          let b = std.io.lex_byte_at(i)
          let d = is_digit(b)
          let und = b == 95
          if d == false {
            if und == false { break }
          }
          i = i + 1
        }
      }
    }
  }
  // Suffix.
  let suffix_start = i
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    let a = is_alpha(b)
    let d = is_digit(b)
    if a == false {
      if d == false { break }
    }
    i = i + 1
  }
  let suffix = std.io.lex_slice(suffix_start, i)
  let kind_str = number_kind_name(suffix, is_float)
  emit(kind_str, start, i)
  i
}

fn number_kind_name(suffix: Str, is_float: Bool) -> Str {
  match suffix {
    "" => if is_float { "FLOAT_LITERAL" } else { "INT_LITERAL" }
    // Duration suffixes (spec §3.5).
    "ns" => "DURATION_LITERAL"
    "us" => "DURATION_LITERAL"
    "ms" => "DURATION_LITERAL"
    "s" => "DURATION_LITERAL"
    "m" => "DURATION_LITERAL"
    "h" => "DURATION_LITERAL"
    // Size suffixes (spec §3.6 + A1 decimal k/M).
    "B" => "SIZE_LITERAL"
    "KiB" => "SIZE_LITERAL"
    "MiB" => "SIZE_LITERAL"
    "GiB" => "SIZE_LITERAL"
    "k" => "SIZE_LITERAL"
    "M" => "SIZE_LITERAL"
    // Float width suffixes.
    "f32" => "FLOAT_LITERAL"
    "f64" => "FLOAT_LITERAL"
    // Int width suffixes.
    "i8" => "INT_LITERAL"
    "i16" => "INT_LITERAL"
    "i32" => "INT_LITERAL"
    "i64" => "INT_LITERAL"
    "i128" => "INT_LITERAL"
    "u8" => "INT_LITERAL"
    "u16" => "INT_LITERAL"
    "u32" => "INT_LITERAL"
    "u64" => "INT_LITERAL"
    "u128" => "INT_LITERAL"
    _ => "ERROR"
  }
}

fn scan_string(start: USize) -> USize {
  // Caller saw the opening `"`. Reads through the closing `"`, honoring
  // `\\` escapes (so `\"` doesn't end the string).
  let n = std.io.lex_len()
  let mut i = start + 1
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    if b == 92 { // '\\' — skip next byte
      i = i + 2
    } else if b == 34 { // '"'
      i = i + 1
      break
    } else {
      i = i + 1
    }
  }
  emit("STRING_LITERAL", start, i)
  i
}

fn scan_char(start: USize) -> USize {
  // Caller saw the opening `'`. Same escape rules as strings.
  let n = std.io.lex_len()
  let mut i = start + 1
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    if b == 92 {
      i = i + 2
    } else if b == 39 { // '\''
      i = i + 1
      break
    } else {
      i = i + 1
    }
  }
  emit("CHAR_LITERAL", start, i)
  i
}

fn scan_html_string(start: USize) -> USize {
  // Caller saw `html"` (5 bytes already classified). Consume through
  // the closing `"`, honoring `\\` escapes.
  let n = std.io.lex_len()
  let mut i = start + 5
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    if b == 92 {
      i = i + 2
    } else if b == 34 {
      i = i + 1
      break
    } else {
      i = i + 1
    }
  }
  emit("HTML_LITERAL", start, i)
  i
}

// ---- Punctuation longest-match -----------------------------------------

fn scan_punct(start: USize) -> USize {
  let n = std.io.lex_len()
  let b0 = std.io.lex_byte_at(start)
  let mut b1: U32 = 256
  let mut b2: U32 = 256
  if start + 1 < n { b1 = std.io.lex_byte_at(start + 1) }
  if start + 2 < n { b2 = std.io.lex_byte_at(start + 2) }

  // Three-byte prefixes first (..= <<= >>=).
  if b0 == 46 && b1 == 46 && b2 == 61 {
    emit("DOT_DOT_EQ", start, start + 3)
    return start + 3
  }
  if b0 == 60 && b1 == 60 && b2 == 61 {
    emit("SHL_EQ", start, start + 3)
    return start + 3
  }
  if b0 == 62 && b1 == 62 && b2 == 61 {
    emit("SHR_EQ", start, start + 3)
    return start + 3
  }

  // Two-byte prefixes.
  if b0 == 61 && b1 == 61 { emit("EQ_EQ", start, start + 2); return start + 2 }
  if b0 == 33 && b1 == 61 { emit("BANG_EQ", start, start + 2); return start + 2 }
  if b0 == 60 && b1 == 61 { emit("LT_EQ", start, start + 2); return start + 2 }
  if b0 == 62 && b1 == 61 { emit("GT_EQ", start, start + 2); return start + 2 }
  if b0 == 38 && b1 == 38 { emit("AMP_AMP", start, start + 2); return start + 2 }
  if b0 == 124 && b1 == 124 { emit("PIPE_PIPE", start, start + 2); return start + 2 }
  if b0 == 60 && b1 == 60 { emit("SHL", start, start + 2); return start + 2 }
  if b0 == 62 && b1 == 62 { emit("SHR", start, start + 2); return start + 2 }
  if b0 == 45 && b1 == 62 { emit("THIN_ARROW", start, start + 2); return start + 2 }
  if b0 == 61 && b1 == 62 { emit("FAT_ARROW", start, start + 2); return start + 2 }
  if b0 == 58 && b1 == 58 { emit("COLON_COLON", start, start + 2); return start + 2 }
  if b0 == 46 && b1 == 46 { emit("DOT_DOT", start, start + 2); return start + 2 }
  if b0 == 43 && b1 == 61 { emit("PLUS_EQ", start, start + 2); return start + 2 }
  if b0 == 45 && b1 == 61 { emit("MINUS_EQ", start, start + 2); return start + 2 }
  if b0 == 42 && b1 == 61 { emit("STAR_EQ", start, start + 2); return start + 2 }
  if b0 == 47 && b1 == 61 { emit("SLASH_EQ", start, start + 2); return start + 2 }
  if b0 == 37 && b1 == 61 { emit("PERCENT_EQ", start, start + 2); return start + 2 }
  if b0 == 38 && b1 == 61 { emit("AMP_EQ", start, start + 2); return start + 2 }
  if b0 == 124 && b1 == 61 { emit("PIPE_EQ", start, start + 2); return start + 2 }
  if b0 == 94 && b1 == 61 { emit("CARET_EQ", start, start + 2); return start + 2 }

  // Single-byte punctuation.
  let kind = single_byte_punct(b0)
  if kind == "" {
    emit("ERROR", start, start + 1)
  } else {
    emit(kind, start, start + 1)
  }
  start + 1
}

fn single_byte_punct(b: U32) -> Str {
  match b {
    40 => "L_PAREN"
    41 => "R_PAREN"
    123 => "L_BRACE"
    125 => "R_BRACE"
    91 => "L_BRACK"
    93 => "R_BRACK"
    44 => "COMMA"
    59 => "SEMI"
    58 => "COLON"
    46 => "DOT"
    64 => "AT"
    63 => "QUESTION"
    33 => "BANG"
    38 => "AMP"
    124 => "PIPE"
    94 => "CARET"
    61 => "EQ"
    60 => "LT"
    62 => "GT"
    43 => "PLUS"
    45 => "MINUS"
    42 => "STAR"
    47 => "SLASH"
    37 => "PERCENT"
    35 => "HASH"
    _ => ""
  }
}

// ---- Identifier-to-keyword lookup -------------------------------------

fn ident_kind_name(s: Str) -> Str {
  match s {
    "true" => "TRUE_KW"
    "false" => "FALSE_KW"
    "agent" => "AGENT_KW"
    "arena" => "ARENA_KW"
    "as" => "AS_KW"
    "async" => "ASYNC_KW"
    "await" => "AWAIT_KW"
    "budget" => "BUDGET_KW"
    "cap" => "CAP_KW"
    "const" => "CONST_KW"
    "effect" => "EFFECT_KW"
    "else" => "ELSE_KW"
    "enum" => "ENUM_KW"
    "extern" => "EXTERN_KW"
    "fn" => "FN_KW"
    "for" => "FOR_KW"
    "if" => "IF_KW"
    "impl" => "IMPL_KW"
    "import" => "IMPORT_KW"
    "in" => "IN_KW"
    "let" => "LET_KW"
    "loop" => "LOOP_KW"
    "match" => "MATCH_KW"
    "mod" => "MOD_KW"
    "move" => "MOVE_KW"
    "mut" => "MUT_KW"
    "on" => "ON_KW"
    "package" => "PACKAGE_KW"
    "protocol" => "PROTOCOL_KW"
    "pub" => "PUB_KW"
    "ref" => "REF_KW"
    "return" => "RETURN_KW"
    "self" => "SELF_KW"
    "spawn" => "SPAWN_KW"
    "state" => "STATE_KW"
    "struct" => "STRUCT_KW"
    "task" => "TASK_KW"
    "trait" => "TRAIT_KW"
    "type" => "TYPE_KW"
    "unsafe" => "UNSAFE_KW"
    "use" => "USE_KW"
    "where" => "WHERE_KW"
    "while" => "WHILE_KW"
    "with" => "WITH_KW"
    "yield" => "YIELD_KW"
    "export" => "EXPORT_KW"
    "sup" => "SUP_KW"
    "sandbox" => "SANDBOX_KW"
    "child" => "CHILD_KW"
    "on_fail" => "ON_FAIL_KW"
    "restart" => "RESTART_KW"
    "backoff" => "BACKOFF_KW"
    "up_to" => "UP_TO_KW"
    "detach" => "DETACH_KW"
    "requires" => "REQUIRES_KW"
    "macro" => "MACRO_KW"
    "run" => "RUN_KW"
    "join" => "JOIN_KW"
    "scope" => "SCOPE_KW"
    "dyn" => "DYN_KW"
    "derive" => "DERIVE_KW"
    _ => "IDENT"
  }
}

// ---- Main loop ---------------------------------------------------------
//
// The top-level driver. Iterates byte-by-byte through the source,
// dispatching on the lead byte to the appropriate sub-scanner. Each
// sub-scanner emits exactly one token and returns the new cursor.
// Returns the number of tokens emitted (including the trailing EOF).

pub fn lex(src: Str) -> USize {
  std.io.lex_init(src)
  let n = std.io.lex_len()
  let mut i: USize = 0
  let mut count: USize = 0
  loop {
    if i >= n { break }
    let b = std.io.lex_byte_at(i)
    let space = is_space(b)
    let id_start = is_ident_start(b)
    let dig = is_digit(b)

    if space == true {
      i = scan_whitespace(i)
      count = count + 1
    } else if id_start == true {
      // Special-case `html"` — only when the FIVE-byte sequence
      // `html` + `"` is exactly that, treat as HTML_LITERAL.
      let mut is_html = false
      if b == 104 {
        if i + 4 < n {
          if std.io.lex_byte_at(i + 1) == 116 {
            if std.io.lex_byte_at(i + 2) == 109 {
              if std.io.lex_byte_at(i + 3) == 108 {
                if std.io.lex_byte_at(i + 4) == 34 {
                  is_html = true
                }
              }
            }
          }
        }
      }
      if is_html == true {
        i = scan_html_string(i)
      } else {
        i = scan_ident_or_keyword(i)
      }
      count = count + 1
    } else if dig == true {
      i = scan_number(i)
      count = count + 1
    } else if b == 34 { // '"'
      i = scan_string(i)
      count = count + 1
    } else if b == 39 { // '\''
      i = scan_char(i)
      count = count + 1
    } else if b == 47 { // '/' — comment or division
      let mut nxt: U32 = 256
      if i + 1 < n { nxt = std.io.lex_byte_at(i + 1) }
      if nxt == 47 {
        i = scan_line_comment(i)
      } else if nxt == 42 {
        i = scan_block_comment(i)
      } else {
        i = scan_punct(i)
      }
      count = count + 1
    } else {
      i = scan_punct(i)
      count = count + 1
    }
  }
  emit("EOF", n, n)
  count + 1
}

// ---- Demo main ---------------------------------------------------------
//
// `mty run selfhost/lexer/lexer.sd` exercises the lexer end-to-end on
// a small canned input. With no host installed, the extern fns return
// Unit/0 via `BufferHost::extern_call`, so the lexer scans an empty
// source: it exits cleanly, demonstrating the pipeline compiles + runs.

fn main() effect io {
  let _ = lex("fn main() { log(\"hi\") }")
  log("selfhost_lexer.lex completed")
}
