##sym Member.anthropic
##sig fn Member.anthropic(model: Str) -> Member
##cap net.https (api.anthropic.com)
##desc Constructs an Anthropic panel member. Reads ANTHROPIC_API_KEY from the environment.
##see Member.openai, Member.gemini, Member.bedrock, Member.ask, Member.mock
##example
let m = Member.anthropic("claude-opus-4-7");
let r = m.ask("Capital of France?")?;
log(r.text);
##end

##sym Member.openai
##sig fn Member.openai(model: Str) -> Member
##cap net.https (api.openai.com)
##desc Constructs an OpenAI panel member. Reads OPENAI_API_KEY from the environment.
##see Member.anthropic, Member.gemini, Member.bedrock, Member.ask
##example
let m = Member.openai("gpt-4o");
let r = m.ask("List 3 primes")?;
log(r.text);
##end

##sym Member.gemini
##sig fn Member.gemini(model: Str) -> Member
##cap net.https (generativelanguage.googleapis.com)
##desc Constructs a Gemini panel member. Reads GOOGLE_API_KEY from the environment.
##see Member.anthropic, Member.openai, Member.bedrock, Member.ask
##example
let m = Member.gemini("gemini-1.5-pro");
let r = m.ask("Summarise this.")?;
log(r.text);
##end

##sym Member.bedrock
##sig fn Member.bedrock(model: Str) -> Member
##cap net.https (bedrock-runtime.<region>.amazonaws.com)
##desc Constructs a Bedrock panel member. Reads AWS_ACCESS_KEY_ID/SECRET from the environment.
##see Member.anthropic, Member.openai, Member.gemini, Member.ask
##example
let m = Member.bedrock("anthropic.claude-3-5-sonnet-20241022-v2:0");
let r = m.ask("hi")?;
log(r.text);
##end

##sym Member.mock
##sig fn Member.mock(name: Str, reply: Str) -> Member
##desc Deterministic stand-in for tests. Returns the canned reply without making a network call.
##see Member.anthropic, Member.ask, swarm
##example
let m = Member.mock("unit", "42");
let r = m.ask("x")?;
assert_eq(r.text, "42");
##end

##sym Member.ask
##sig fn Member.ask(&self, prompt: Str) -> Result<MemberReply, LlmError>
##cap net.https (for the provider endpoint)
##desc Sends prompt to the LLM provider and returns the reply.
##see Member.anthropic, Member.openai, std.swarm, swarm
##example
let m = Member.anthropic("claude-opus-4-7");
let r = m.ask("Capital of France?")?;
log(r.text);
##end

##sym MemberReply.text
##sig field MemberReply.text: Str
##desc Plain-text body of the assistant reply.
##see Member.ask, MemberReply.tokens_used, MemberReply.cost_cents
##example
let r = m.ask("hi")?;
log(r.text);
##end

##sym MemberReply.tokens_used
##sig field MemberReply.tokens_used: U64
##desc Total tokens billed for this turn (input + output).
##see MemberReply.cost_cents, MemberReply.text
##example
let r = m.ask("hi")?;
log(format!("tokens={}", r.tokens_used));
##end

##sym MemberReply.cost_cents
##sig field MemberReply.cost_cents: U64
##desc Provider-reported cost of this turn, in cents.
##see MemberReply.tokens_used, DollarBudget.from_dollars
##example
let r = m.ask("hi")?;
log(format!("cost_cents={}", r.cost_cents));
##end

##sym Member.label
##sig fn Member.label(&self) -> Str
##desc Human-readable identifier for the member (provider + model + optional alias). Use in logs and dashboards. Stable across calls — safe to use as a group-by key.
##see Member.model, Member.anthropic, GroupBy.Provider
##example
log(format("{}: {} cents", member.label(), reply.cost_cents));
##end

##sym Member.model
##sig fn Member.model(&self) -> Str
##desc Just the model string (e.g. `"claude-opus-4-7"`). For the full provider/model breadcrumb use `label`.
##see Member.label, Member.anthropic, Member.openai
##example
log(member.model());
##end

##sym Member.mock_error
##sig fn Member.mock_error(name: Str, body: Str) -> Member
##desc Mock member that always errors with `body`. Use in tests to exercise error-path policy without hitting a real provider.
##see Member.mock, Member.mock_with_tool_uses
##example
let bad = Member.mock_error("flaky", "503 upstream timeout");
##end

##sym Member.mock_with_tool_uses
##sig fn Member.mock_with_tool_uses(name: Str, reply: Str, tools: Vec[ToolUse], cost_cents: U64) -> Member
##desc Mock member that responds with `reply` AND advertises `tools` as the tool-uses the reply executed. Use to test consumer code that branches on `MemberReply.tool_uses`.
##see Member.mock, MemberReply.tool_uses, ToolUse
##example
let m = Member.mock_with_tool_uses("agent", "done", vec![tool_use("fs.read")], 0);
##end

##sym MemberReply.tool_uses
##sig fn MemberReply.tool_uses(&self) -> &[ToolUse]
##desc Tool invocations the model emitted as part of this reply. Empty for non-tool-using replies.
##see MemberReply.tool_names, Member.mock_with_tool_uses, ToolUse
##example
for tool in reply.tool_uses() {
  log(tool.name);
}
##end

##sym MemberReply.tool_names
##sig fn MemberReply.tool_names(&self) -> Vec[Str]
##desc Just the tool names from `tool_uses`. Convenience for assertions and budget gates that key off the tool surface only.
##see MemberReply.tool_uses, Compare.tool_call_set_equal
##example
assert!(reply.tool_names().contains(&"fs.read".to_string()));
##end

##sym MemberReply.cost
##sig fn MemberReply.cost(&self) -> F64
##desc Dollar cost of this reply (= `cost_cents / 100.0`). Convenience over `cost_cents` when you want to display dollars.
##see MemberReply.cost_cents, MemberReply.tokens_used
##example
log(format("${:.4}", reply.cost()));
##end

